# OakFox root .htaccess

Options -Indexes
DirectorySlash On

# --- Compress text responses (off by default on this server) ---
# Pages, CSS, JS and SVG shrink by about three quarters; images and woff2 are
# already compressed. Part of what keeps the site at A+ in our own carbon audit.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

RewriteEngine On

# --- Canonical host: force https://oakfox.co.uk (no www) ---
# Matches astro.config.mjs (site: 'https://oakfox.co.uk') and JSON-LD schema.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.oakfox\.co\.uk$ [NC]
RewriteRule ^(.*)$ https://oakfox.co.uk/$1 [R=301,L]

# --- Force trailing slash on directory-style URLs (301) ---
# Excludes existing files and URLs with file extensions.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]+$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# --- The sitemap is /sitemap-index.xml; Bingbot still asks for the usual name ---
RedirectMatch 301 ^/sitemap\.xml$ https://oakfox.co.uk/sitemap-index.xml

# --- Former ecology pages (EcoScribe closed Oct 2026) — keep permanently ---
RedirectMatch 301 ^/services/environmental/automation/?$        https://oakfox.co.uk/services/environmental/
RedirectMatch 301 ^/services/environmental/consultancy/?$       https://oakfox.co.uk/services/environmental/
RedirectMatch 301 ^/blog/what-a-pea-actually-contains/?$        https://oakfox.co.uk/services/environmental/
RedirectMatch 301 ^/blog/cost-of-a-preliminary-ecological-appraisal/?$  https://oakfox.co.uk/services/environmental/
RedirectMatch 301 ^/blog/biodiversity-net-gain-small-sites-guide/?$     https://oakfox.co.uk/services/environmental/
RedirectMatch 301 ^/blog/bng-is-burying-ecological-consultancies/?$     https://oakfox.co.uk/services/environmental/
RedirectMatch 301 ^/blog/introducing-ecoscribe/?$     https://oakfox.co.uk/services/environmental/

# --- Legacy WordPress URLs (old oakfox.co.uk) → current equivalents ---
RedirectMatch 301 ^/my-work/branding/aigean/?$ /portfolio/
RedirectMatch 301 ^/my-work/branding/?$ /services/branding/
RedirectMatch 301 ^/my-work/design/?$ /portfolio/
RedirectMatch 301 ^/my-work/development/?$ /portfolio/
RedirectMatch 301 ^/my-work/?$ /portfolio/
RedirectMatch 301 ^/about-me/?$ /about/
RedirectMatch 301 ^/about-us/?$ /about/
RedirectMatch 301 ^/contact-me/?$ /contact/
RedirectMatch 301 ^/contact-us/?$ /contact/
RedirectMatch 301 ^/whats-new-for-2025-a-design-jump-forward/?$ /blog/

# --- Retired portfolio entries → 410 Gone ---
RedirectMatch gone ^/portfolio/aigean/?$
RedirectMatch gone ^/portfolio/roll/?$

# --- Foreign legacy URLs (listings-era, no equivalent) → 410 Gone ---
RedirectMatch gone ^/listing/
RedirectMatch gone ^/website-referral/?$
RedirectMatch gone ^/categories/?$
RedirectMatch gone ^/registry/?$
RedirectMatch gone ^/legal/?$
RedirectMatch gone ^/\*$

# --- WordPress leftover paths → 410 Gone ---
RedirectMatch gone ^/wp-content(/|$)
RedirectMatch gone ^/wp-admin(/|$)
RedirectMatch gone ^/wp-includes(/|$)
RedirectMatch gone ^/wp-json(/|$)
RedirectMatch gone ^/wp-login\.php$
RedirectMatch gone ^/xmlrpc\.php$
RedirectMatch gone ^/feed(/|$)
RedirectMatch gone ^/comments/feed(/|$)
RedirectMatch gone ^/author/
RedirectMatch gone ^/tag/
RedirectMatch gone ^/category/
