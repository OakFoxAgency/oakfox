---
// Related reading from the journal, as cards.
interface Post {
  href: string;
  title: string;
  note: string;
}

interface Props {
  intro: string;
  posts: Post[];
  title?: string;
}

const { intro, posts, title = 'Read before you brief anyone' } = Astro.props;
---

<section class="py-16 md:py-24 border-t border-stone">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10">
    <h2 class="headline text-4xl md:text-5xl">{title}</h2>
    <p class="mt-5 text-lg text-ink/70 leading-relaxed max-w-[56ch]">{intro}</p>
    <ul class={`mt-10 md:mt-12 grid gap-4 md:gap-5 ${posts.length > 1 ? 'md:grid-cols-2' : ''} ${posts.length === 3 ? 'lg:grid-cols-3' : ''}`}>
      {posts.map((p) => (
        <li class="reveal">
          <a href={p.href} class="group flex h-full flex-col rounded-2xl bg-moss p-7 md:p-9 transition-transform duration-300 hover:-translate-y-0.5">
            <span class="text-2xl font-semibold tracking-tight text-ink group-hover:text-forest transition-colors">{p.title}</span>
            <span class="mt-3 text-base text-ink/70 leading-relaxed">{p.note}</span>
            <span class="mt-6 inline-flex items-center gap-2 text-[15px] font-medium text-forest">
              Read it
              <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
