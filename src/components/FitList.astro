---
// "Who it's for": plain statements in two columns, each ticked.
interface Props {
  title?: string;
  items: string[];
}
const { title = "Who it's for", items } = Astro.props;
---

<section class="py-16 md:py-24 border-t border-stone">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10">
    <h2 class="headline text-4xl md:text-5xl">{title}</h2>
    <ul class="mt-10 md:mt-12 grid md:grid-cols-2 gap-x-12 gap-y-6">
      {items.map((line) => (
        <li class="reveal flex gap-4 text-lg md:text-xl text-ink/85 leading-snug">
          <span class="mt-0.5 shrink-0 w-7 h-7 rounded-full bg-moss text-forest grid place-items-center" aria-hidden="true">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
          <span>{line}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
