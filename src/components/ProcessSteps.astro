---
// How a project runs, as a timeline: across the page on large screens, down
// the left on phones. The line draws in and the stops appear in order as it
// scrolls into view. Step titles are the verbs; no numbering.
interface Step {
  title: string;
  body: string;
  link?: { label: string; href: string };
}
interface Props {
  title: string;
  steps: Step[];
}
const { title, steps } = Astro.props;
---

<section class="py-16 md:py-24 border-t border-stone">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10">
    <h2 class="headline text-4xl md:text-5xl max-w-[20ch]">{title}</h2>
    <ol data-demo class="timeline mt-12 md:mt-16" style={`--n: ${steps.length}`}>
      {steps.map((s, i) => (
        <li class="stop" style={`--i: ${i}`}>
          <span class="stop-dot" aria-hidden="true"></span>
          <h3 class="text-xl font-semibold tracking-tight">{s.title}</h3>
          <p class="mt-2 text-base text-ink/70 leading-relaxed">{s.body}</p>
          {s.link && (
            <a href={s.link.href} class="mt-3 inline-block text-[15px] font-medium text-forest underline underline-offset-4 hover:text-forest-dark transition-colors">{s.link.label}</a>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .timeline { position: relative; display: grid; gap: 2.25rem; padding-left: 2rem; }
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.4375rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--color-forest);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.4s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .stop { position: relative; opacity: 0; transform: translateY(10px); transition: opacity 0.6s, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(0.2s + var(--i) * 0.18s); }
  .stop-dot {
    position: absolute;
    left: -2rem;
    top: 0.3rem;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: var(--color-cream);
    border: 3px solid var(--color-forest);
  }
  .timeline:global(.is-in)::before { transform: scaleY(1); }
  .timeline:global(.is-in) .stop { opacity: 1; transform: none; }

  @media (min-width: 1024px) {
    .timeline { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 2rem; padding: 2.25rem 0 0; }
    .timeline::before { left: 0.5rem; right: 0.5rem; top: 0.4375rem; bottom: auto; width: auto; height: 2px; transform: scaleX(0); transform-origin: left; }
    .timeline:global(.is-in)::before { transform: scaleX(1); }
    .stop-dot { left: 0; top: -2.25rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline::before { transform: none !important; transition: none; }
    .stop { opacity: 1; transform: none; transition: none; }
  }
</style>
