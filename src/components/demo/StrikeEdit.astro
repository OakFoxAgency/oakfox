---
// Copywriting demo: a vague claim struck through, a checkable one written in.
interface Props {
  before?: string;
  after?: string;
  class?: string;
}
const {
  before = 'Our eco-friendly, planet-positive solutions',
  after = 'Hosted on renewable power, and you can check it.',
  class: className = '',
} = Astro.props;
---

<p data-demo class={`edit ${className}`} aria-hidden="true">
  <span class="edit-old">{before}</span>
  <span class="edit-new">{after}</span>
</p>

<style>
  .edit { font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; }
  /* The strike is a background line on the inline span, so it draws across
     every wrapped line in reading order. */
  .edit-old {
    color: color-mix(in oklab, currentColor 45%, transparent);
    background: linear-gradient(#a63a1b, #a63a1b) no-repeat 0 58% / 0% 2px;
  }
  .edit-new {
    display: block;
    margin-top: 0.75rem;
    color: var(--color-forest);
    opacity: 0;
    transform: translateY(6px);
  }
  .edit:global(.is-in) .edit-old { animation: strike 1.1s 0.4s cubic-bezier(0.65, 0, 0.35, 1) forwards; }
  .edit:global(.is-in) .edit-new { animation: write-in 0.7s 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  @keyframes strike { to { background-size: 100% 2px; } }
  @keyframes write-in { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .edit-old { background-size: 100% 2px; }
    .edit-new { opacity: 1; transform: none; }
    .edit:global(.is-in) .edit-old, .edit:global(.is-in) .edit-new { animation: none; }
  }
</style>
