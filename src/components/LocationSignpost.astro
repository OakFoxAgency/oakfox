---
// Where a service is offered, as links to each location page (internal links
// for local search). Distance shows on hover as a title.
import { locations } from '../data/locations';

interface Props {
  service: string;
  keyword: string;
}

const { service, keyword } = Astro.props;
---

<section class="py-16 md:py-24 border-t border-stone">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10 grid lg:grid-cols-12 gap-10 lg:gap-16 items-end">
    <div class="lg:col-span-5">
      <h2 class="headline text-4xl md:text-5xl">{service} across the North West</h2>
      <p class="mt-6 text-lg text-ink/70 leading-relaxed max-w-[44ch]">
        Our studio is in rural West Lancashire. We work with {keyword} clients
        locally, across the North West, and remotely across the UK, Ireland and Europe.
      </p>
    </div>
    <ul class="lg:col-span-7 flex flex-wrap gap-3">
      {locations.map((l) => (
        <li>
          <a
            href={`/locations/${l.slug}/`}
            title={l.distance}
            class="inline-flex items-center gap-2 rounded-full border border-stone bg-cream-light px-5 py-3 text-[15px] font-medium text-ink hover:border-forest hover:text-forest transition-colors"
          >
            {service} in {l.name}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
