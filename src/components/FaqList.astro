---
// Questions as an accordion. Answers stay in the HTML (inside <details>), so
// search engines and the page's FAQPage schema still see every one. The
// default slot sits under the heading, for a related link.
interface Item {
  q: string;
  a: string;
}
interface Props {
  title?: string;
  items: Item[];
}
const { title = 'Questions we hear a lot', items } = Astro.props;
---

<section class="py-16 md:py-24 border-t border-stone">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10 grid lg:grid-cols-12 gap-10 lg:gap-16">
    <div class="lg:col-span-4">
      <h2 class="headline text-4xl md:text-5xl">{title}</h2>
      <div class="mt-6 text-base text-ink/70 leading-relaxed max-w-[36ch]"><slot /></div>
    </div>
    <div class="lg:col-span-8 border-t border-stone">
      {items.map((f) => (
        <details class="faq border-b border-stone">
          <summary class="flex items-start justify-between gap-6 py-6 cursor-pointer list-none">
            <span class="text-lg md:text-xl font-semibold tracking-tight text-ink">{f.q}</span>
            <span class="plus shrink-0 mt-1.5 w-5 h-5 relative" aria-hidden="true"></span>
          </summary>
          <p class="pb-7 -mt-1 text-base md:text-[17px] text-ink/70 leading-relaxed max-w-[68ch]">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker { display: none; }
  summary:hover span:first-child { color: var(--color-forest); }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: var(--color-forest);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .plus::after { transform: rotate(90deg); }
  .faq[open] .plus::after { transform: rotate(0deg); }
</style>
