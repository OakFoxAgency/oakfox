---
// The live carbon meter: this page's own first view by type of file, filled in
// by scripts/page-weight.ts, with the free audit underneath. Built-in text is
// a fair estimate for browsers that don't report resource timing.
import study from '../../public/data/oakfox-uk-sme-carbon-study-2026-07-aggregates.json';

interface Props {
  heading?: string;
  showForm?: boolean;
  class?: string;
}
const { heading = 'This page, as it loaded on your screen', showForm = true, class: className = '' } = Astro.props;
const medianMB = (study.weight.medKB / 1000).toFixed(1);
const kinds = [
  { key: 'html', label: 'HTML', c: 1 },
  { key: 'css', label: 'CSS', c: 0.8 },
  { key: 'js', label: 'JavaScript', c: 0.62 },
  { key: 'fonts', label: 'Fonts', c: 0.46 },
  { key: 'images', label: 'Images', c: 0.3 },
];
---

<div class={`meter rounded-2xl bg-ink text-cream p-6 md:p-7 ${className}`} data-meter>
  <div class="flex items-center gap-5">
    <div class="relative shrink-0 w-24 h-24 md:w-28 md:h-28">
      <svg viewBox="0 0 120 120" class="w-full h-full -rotate-90" aria-hidden="true">
        <circle cx="60" cy="60" r="52" fill="none" stroke="currentColor" stroke-opacity="0.12" stroke-width="10" />
        <circle
          data-meter-arc
          cx="60" cy="60" r="52" fill="none"
          stroke="var(--color-leaf)" stroke-width="10" stroke-linecap="round"
          stroke-dasharray="326.7" stroke-dashoffset="297"
        />
      </svg>
      <div class="absolute inset-0 flex flex-col items-center justify-center">
        <span data-meter-grade class="figures text-3xl md:text-4xl font-semibold tracking-tight">A+</span>
        <span class="text-[11px] text-cream/80">carbon rating</span>
      </div>
    </div>
    <div>
      <p class="text-[15px] font-semibold">{heading}</p>
      <p class="mt-1 text-[14px] text-cream/80 leading-snug" data-meter-summary>
        About 0.02 g of CO₂, around a tenth of the {medianMB} MB of a typical UK small business homepage.
      </p>
    </div>
  </div>
  <div class="mt-6 flex h-2.5 rounded-full overflow-hidden bg-cream/10" aria-hidden="true">
    {kinds.map((k) => <span class="seg" style={`--c: ${k.c}`} data-seg={k.key}></span>)}
  </div>
  <dl class="mt-3 grid grid-cols-3 sm:grid-cols-5 gap-x-3 gap-y-2 text-[12px]">
    {kinds.map((k) => (
      <div>
        <dt class="text-cream/55">{k.label}</dt>
        <dd class="figures text-cream" data-seg-kb={k.key}>…</dd>
      </div>
    ))}
  </dl>
  {showForm && (
    <form action="/website-carbon-audit/" method="get" class="mt-6 pt-6 border-t border-cream/10">
      <label for="meter-audit-url" class="block text-[15px] font-semibold">How does your website compare?</label>
      <div class="mt-3 flex flex-col sm:flex-row lg:flex-col xl:flex-row gap-3">
        <input
          id="meter-audit-url"
          name="url"
          type="text"
          inputmode="url"
          autocomplete="url"
          spellcheck="false"
          placeholder="yourwebsite.co.uk"
          required
          class="flex-1 min-w-0 bg-cream/[0.06] border border-cream/20 rounded-full px-5 py-3 text-[15px] text-cream placeholder:text-cream/50 focus:outline-none focus:border-leaf transition-colors duration-300"
        />
        <button type="submit" class="btn-light">Get my grade</button>
      </div>
      <p class="mt-3 text-[13px] text-cream/80">Free, instant, and no email needed.</p>
    </form>
  )}
</div>

<style>
  [data-meter-arc] { transition: stroke-dashoffset 1.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .seg {
    display: block;
    width: var(--w, 20%);
    background: color-mix(in oklab, var(--color-leaf) calc(var(--c) * 100%), var(--color-ink));
    transition: width 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-meter-arc], .seg { transition: none; }
  }
</style>
