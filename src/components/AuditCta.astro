---
// The free carbon audit as a band inside the page: an ink panel with the form.
// The form is a plain GET to /website-carbon-audit/, which runs a ?url= audit
// on load, so it works with no JavaScript at all.
interface Props {
  intro?: string;
}

const {
  intro = 'Get an A+ to F grade in seconds, with page weight, CO₂ per visit and a verified green hosting check.',
} = Astro.props;
---

<section class="py-12 md:py-16">
  <div class="max-w-[1400px] mx-auto px-6 md:px-10">
    <div class="rounded-2xl bg-ink text-cream p-7 md:p-12 grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-6">
        <h2 class="headline text-3xl md:text-5xl text-cream">How green is your website?</h2>
        <p class="mt-4 text-lg text-cream/70 leading-relaxed max-w-[46ch]">{intro}</p>
      </div>
      <form action="/website-carbon-audit/" method="get" class="lg:col-span-6">
        <label for="audit-cta-url" class="block text-[15px] font-semibold">Your website address</label>
        <div class="mt-3 flex flex-col sm:flex-row gap-3">
          <input
            id="audit-cta-url"
            name="url"
            type="text"
            inputmode="url"
            autocomplete="url"
            spellcheck="false"
            placeholder="yourwebsite.co.uk"
            required
            class="flex-1 min-w-0 bg-cream/[0.06] border border-cream/20 rounded-full px-5 py-3.5 text-[15px] text-cream placeholder:text-cream/50 focus:outline-none focus:border-leaf transition-colors duration-300"
          />
          <button type="submit" class="btn-light">Get my grade</button>
        </div>
        <p class="mt-3 text-[13px] text-cream/60">
          Free, instant, and no email needed.
          <a href="/website-carbon-audit/" class="underline underline-offset-4 hover:text-cream transition-colors">How it works</a>
        </p>
      </form>
    </div>
  </div>
</section>
