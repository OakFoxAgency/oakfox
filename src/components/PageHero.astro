---
// The hero for inner pages: H1 (optionally with a place line inside it, for
// local ranking), a short intro and the two calls to action on the left; an
// optional visual in the `aside` slot on the right (a demo, the meter, an
// image). Words listed in `accent` are coloured forest. Runs the same
// entrance as the homepage (data-scene="hero" in motion.ts).
interface Action {
  label: string;
  href: string;
}
interface Props {
  title: string;
  accent?: string;
  place?: string;
  intro?: string;
  back?: Action;
  primary?: Action | null;
  secondary?: Action | null;
}
const {
  title,
  accent = '',
  place,
  intro,
  back,
  primary = { label: 'Start a project', href: '/contact/' },
  secondary = { label: 'Book a call', href: '/book/' },
} = Astro.props;
const hasAside = Astro.slots.has('aside');
const words = title.split(' ');
const accentWords = new Set(accent.split(' ').filter(Boolean));
---

<section data-scene="hero" class="relative">
  <div class={`w-full max-w-[1400px] mx-auto px-6 md:px-10 pt-28 md:pt-36 pb-14 md:pb-20 grid gap-y-12 lg:gap-x-12 xl:gap-x-16 items-center ${hasAside ? 'lg:grid-cols-12' : ''}`}>
    <div class={hasAside ? 'lg:col-span-7' : 'max-w-5xl'}>
      {back && (
        <a href={back.href} class="inline-flex items-center gap-2 mb-6 text-[14px] font-medium text-ink/60 hover:text-forest transition-colors">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {back.label}
        </a>
      )}
      <h1 class="headline page-title text-ink">
        {words.map((w, i) => (
          <><span class="split-word"><span>{accentWords.has(w.replace(/[.,!?]$/, '')) ? <em>{w}</em> : w}</span></span>{i < words.length - 1 && ' '}</>
        ))}
        {place && <span class="page-place"><span class="split-word"><span>{place}</span></span></span>}
      </h1>
      {intro && (
        <p data-hero-paragraph class="mt-7 text-lg md:text-xl text-ink/70 leading-relaxed max-w-[46ch]">{intro}</p>
      )}
      {(primary || secondary) && (
        <div data-hero-cta class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
          {primary && <a href={primary.href} class="btn-primary">{primary.label}</a>}
          {secondary && (
            <a href={secondary.href} class="link-line text-[15px] font-medium text-ink hover:text-forest transition-colors">{secondary.label}</a>
          )}
        </div>
      )}
      <slot />
    </div>
    {hasAside && (
      <div data-hero-aside class="lg:col-span-5 max-w-xl lg:max-w-none">
        <slot name="aside" />
      </div>
    )}
  </div>
</section>

<style>
  .page-title {
    font-size: clamp(2.4rem, 4.4vw, 4.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
  }
  .page-place {
    display: block;
    margin-top: 1rem;
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: color-mix(in oklab, var(--color-ink) 58%, transparent);
  }
</style>
