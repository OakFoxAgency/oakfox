---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Pillars from '../components/Pillars.astro';
import FaqList from '../components/FaqList.astro';
import { GRADE_COLORS } from '../lib/carbon.mjs';

const pageUrl = 'https://oakfox.co.uk/carbon-badge';

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Website Carbon Audit',
      item: 'https://oakfox.co.uk/website-carbon-audit',
    },
    { '@type': 'ListItem', position: 3, name: 'Carbon Rating Badge', item: pageUrl },
  ],
};

const webPage = {
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: 'The OakFox Carbon Rating Badge',
  description:
    'A free embeddable badge for websites rated A+, A or B in the OakFox website carbon audit. Links to a live re-audit so the rating is always verifiable.',
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://oakfox.co.uk/#website' },
  about: { '@id': 'https://oakfox.co.uk/#organization' },
};

const faqs = [
  {
    q: 'Who can display the badge?',
    a: 'Any website that scores A+, A or B in the audit. It is free, with no fee and no application: if your site earned the grade, the embed code appears with your results and you are welcome to use it.',
  },
  {
    q: 'What happens if my rating changes later?',
    a: 'The badge links to a live re-run of the audit rather than a saved result, so whatever a visitor sees when they click is measured fresh that moment. Nothing to keep updated on your side. If your site slips below B, we would ask you to take the badge down, but the link will show the honest grade either way, which is rather the point.',
  },
  {
    q: 'Can I recolour it or crop it to fit my design?',
    a: 'Please do not. A badge that has been edited stops being evidence of anything. There is a light and a dark version, in SVG and PNG, which covers almost every footer. If none of them work for your site, email us and we will look at it.',
  },
  {
    q: 'Does the link have to stay on it?',
    a: 'Yes. The badge makes a claim about a measurement, and the link is how a visitor checks that claim is true. A badge nobody can verify is just a graphic.',
  },
  {
    q: 'How heavy is the badge itself?',
    a: 'The SVG is 458 bytes over the wire. It would be a poor advert for lightweight web design if the badge were the heaviest thing in your footer.',
  },
  {
    q: 'Why does the badge not show my exact CO₂ figure?',
    a: 'Because it would go out of date the next time you edited a page, and you would have no way of knowing. The grade is stable enough to put in a file; the gram figure belongs on the live audit where it is re-measured on demand.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const variants = [
  { grade: 'A+', file: 'carbon-a-plus', limit: 'Under 0.040 g' },
  { grade: 'A', file: 'carbon-a', limit: 'Under 0.079 g' },
  { grade: 'B', file: 'carbon-b', limit: 'Under 0.145 g' },
];

// The whole scale, so the cut-off is visible: badges stop at B.
const scale = ['A+', 'A', 'B', 'C', 'D', 'E', 'F'].map((g) => ({
  grade: g,
  colour: GRADE_COLORS[g as keyof typeof GRADE_COLORS],
  badge: ['A+', 'A', 'B'].includes(g),
}));

const principles = [
  {
    title: 'The link re-audits live',
    description:
      'Clicking the badge runs the audit again from scratch, against your site as it is at that moment, not against a result we saved when you first earned it. There is nothing for you to maintain, and nothing we can quietly leave stale.',
  },
  {
    title: 'It carries a grade, not a number',
    description:
      'A gram figure baked into an image starts drifting the moment you add a photo to a page, and you would never know. The grade is stable enough to sit in a file for a year; the precise figure lives where it can be measured again.',
  },
  {
    title: 'If your site gets heavier, the audit says so',
    description:
      'We would ask you to take the badge down if you drop below B, but we are not policing footers. Anyone who clicks sees the real current grade, whichever badge is sitting above it.',
  },
];
---

<BaseLayout
  title="The Carbon Rating Badge"
  description="A free embeddable badge for websites rated A+, A or B in the OakFox website carbon audit. 458 bytes, linked to a live re-audit, and honest about what it measures."
  schema={[webPage, faqSchema, breadcrumbs]}
>
  <PageHero
    back={{ label: 'Website carbon audit', href: '/website-carbon-audit/' }}
    title="Proof you can put in your footer."
    accent="footer."
    intro="If your website scores A+, A or B in our free carbon audit, it is lighter than most of the web. This badge says so, and links to a live re-measurement so anyone can check. It's free, with no application, no fee and nothing to sign."
    primary={{ label: 'Audit your site', href: '/website-carbon-audit/' }}
    secondary={{ label: 'See the grades', href: '#grades' }}
  >
    <div slot="aside" class="grid gap-4">
      <div class="rounded-2xl border border-stone bg-cream-light p-8 md:p-10 grid place-items-center">
        <img src="/badge/carbon-a-plus.svg" alt="Carbon rating A+ badge, light style" width="300" height="84" class="w-[min(300px,100%)] h-auto" />
      </div>
      <div class="rounded-2xl bg-ink p-8 md:p-10 grid place-items-center">
        <img src="/badge/carbon-a-plus-dark.svg" alt="Carbon rating A+ badge, dark style" width="300" height="84" class="w-[min(300px,100%)] h-auto" />
      </div>
      <p class="text-[14px] text-ink/60 text-center">458 bytes as SVG. Lighter than a line of text on most pages.</p>
    </div>
  </PageHero>

  <!-- The scale, with the cut-off marked, then the three badges. -->
  <section id="grades" class="py-16 md:py-24 border-t border-stone scroll-mt-24">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-end">
        <div class="lg:col-span-6">
          <h2 class="headline text-4xl md:text-5xl">Three grades earn it. Four don't.</h2>
          <p class="mt-6 text-lg text-ink/70 leading-relaxed max-w-[48ch]">
            Bands come from the Sustainable Web Design Model, as applied by
            <a href="https://www.thegreenwebfoundation.org/co2-js/" target="_blank" rel="noopener noreferrer" class="text-forest underline underline-offset-4">co2.js</a>.
            Grams are CO₂e per page view. Below B there is no badge: we are not
            going to hand out a graphic for a middling result.
          </p>
        </div>
        <ol data-demo class="scale lg:col-span-6 grid grid-cols-7 gap-1.5" aria-label="The carbon grades, A+ to F. Badges go to A+, A and B.">
          {scale.map((s, i) => (
            <li class={`scale-step ${s.badge ? '' : 'scale-off'}`} style={`--g: ${s.colour}; --i: ${i}`}>
              <span class="scale-bar"></span>
              <span class="mt-2 block text-center text-[15px] font-semibold">{s.grade}</span>
            </li>
          ))}
        </ol>
      </div>

      <div class="mt-12 md:mt-16 grid md:grid-cols-3 gap-4 md:gap-5">
        {variants.map((v) => (
          <div class="reveal rounded-2xl border border-stone bg-cream-light overflow-hidden">
            <div class="p-6 md:p-7 grid place-items-center min-h-[7rem]">
              <img src={`/badge/${v.file}.svg`} alt={`Carbon rating ${v.grade} badge, light style`} width="200" height="56" loading="lazy" decoding="async" />
            </div>
            <div class="bg-ink p-6 md:p-7 grid place-items-center min-h-[7rem]">
              <img src={`/badge/${v.file}-dark.svg`} alt={`Carbon rating ${v.grade} badge, dark style`} width="200" height="56" loading="lazy" decoding="async" />
            </div>
            <div class="px-6 md:px-7 py-5 flex items-baseline justify-between gap-4">
              <span class="text-2xl font-semibold tracking-tight">{v.grade}</span>
              <span class="text-[15px] text-ink/65">{v.limit} per view</span>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-6 text-[15px] text-ink/60 leading-relaxed max-w-[70ch]">
        Each badge comes in SVG and PNG. Use the SVG unless your site builder
        refuses it. Wix and Squarespace both reject SVG uploads in places, which
        is the only reason the PNG exists.
      </p>
    </div>
  </section>

  <Pillars title="How it stays honest" items={principles} />

  <FaqList title="Questions about the badge" items={faqs} />

  <!-- Close: the forest block, pointing at the audit. -->
  <section class="bg-forest text-cream">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-24 md:py-36">
      <h2 class="headline text-cream text-[length:clamp(3rem,8vw,7.5rem)] max-w-[12ch]">Find out where you stand.</h2>
      <div class="mt-10 max-w-[44rem]">
        <p class="text-xl text-cream/80 leading-relaxed">
          The audit takes about twenty seconds and needs nothing but your web
          address. At B or better, the embed code is waiting with your results.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="/website-carbon-audit/" class="btn-light">Run the free audit</a>
          <a href="/book/" class="link-line text-[15px] font-medium text-cream">Book a call</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .scale-bar {
    display: block;
    height: 4.5rem;
    border-radius: 0.5rem;
    background: var(--g);
    transform: scaleY(0.2);
    transform-origin: bottom;
    opacity: 0;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s;
    transition-delay: calc(var(--i) * 70ms);
  }
  .scale:global(.is-in) .scale-bar { transform: none; opacity: 1; }
  .scale-off .scale-bar {
    background: repeating-linear-gradient(135deg, var(--g) 0 6px, color-mix(in oklab, var(--g) 55%, var(--color-cream)) 6px 12px);
  }
  .scale:global(.is-in) .scale-off .scale-bar { opacity: 0.35; }
  .scale-off { color: color-mix(in oklab, var(--color-ink) 45%, transparent); }
  @media (prefers-reduced-motion: reduce) {
    .scale-bar { transform: none; opacity: 1; transition: none; }
    .scale-off .scale-bar { opacity: 0.35; }
  }
</style>
