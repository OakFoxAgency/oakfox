  <!-- ============ Close: the forest block, pointing at the free plan ============ -->
  <section class="bg-forest text-cream">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 py-24 md:py-36">
      <h2 class="headline text-cream text-[length:clamp(3rem,8vw,7.5rem)] max-w-[12ch]">Didn't like your grade?</h2>
      <div class="mt-10 max-w-[46rem]">
        <p class="text-xl text-cream/80 leading-relaxed">
          Send us your URL and we'll reply within 24 hours with the three changes
