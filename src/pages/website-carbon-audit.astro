  <!-- ============ The study ============ -->
  <section class="py-16 md:py-24 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <CarbonWaffle class="lg:col-span-7" />
      <div class="lg:col-span-5">
