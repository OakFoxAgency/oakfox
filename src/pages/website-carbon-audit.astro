---
import BaseLayout from '../layouts/BaseLayout.astro';
import JournalLinks from '../components/JournalLinks.astro';
import PageHero from '../components/PageHero.astro';
import Pillars from '../components/Pillars.astro';
import FaqList from '../components/FaqList.astro';
import CarbonMeter from '../components/CarbonMeter.astro';
import CarbonWaffle from '../components/CarbonWaffle.astro';
import { GRADE_COLORS } from '../lib/carbon.mjs';
import study from '../../public/data/oakfox-uk-sme-carbon-study-2026-07-aggregates.json';

const pageUrl = 'https://oakfox.co.uk/website-carbon-audit';

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Website Carbon Audit', item: pageUrl },
  ],
};

const webApplication = {
  '@type': 'WebApplication',
  '@id': `${pageUrl}#webapp`,
  name: 'Free Website Carbon Audit',
  url: pageUrl,
  description:
    'Free website sustainability checker. Enter a URL and get an instant carbon audit: CO₂ per page view, page weight, a green hosting check, and an A+ to F grade based on the Sustainable Web Design Model.',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
  provider: { '@id': 'https://oakfox.co.uk/#organization' },
  featureList: [
    'CO₂e per page view estimate (Sustainable Web Design Model)',
    'A+ to F digital carbon rating',
    'Page weight / data transfer measurement',
    'Green hosting verification against The Green Web Foundation directory',
    'Comparison against the median web page',
  ],
};

// Sustainable Web Design digital carbon ratings: grams CO2e per visit, as
// applied by co2.js perVisit. Bands mirror the published percentiles of pages
// tested worldwide.
const gradeBands = [
  { grade: 'A+', limit: '0.040 g', meaning: 'The top 5% of pages tested worldwide. Genuinely exceptional.' },
  { grade: 'A', limit: '0.079 g', meaning: 'Top 10%. A lean, well-built page.' },
  { grade: 'B', limit: '0.145 g', meaning: 'Top 20%. Lighter than most of the web.' },
  { grade: 'C', limit: '0.209 g', meaning: 'Top 30%. Middling, usually with easy wins available.' },
  { grade: 'D', limit: '0.278 g', meaning: 'Top 40%. Heavier than it needs to be.' },
  { grade: 'E', limit: '0.359 g', meaning: 'Around the median. Half the web does better.' },
  { grade: 'F', limit: 'over 0.359 g', meaning: 'Heavier than the median page. There is real work to do.' },
];

const checks = [
  {
    label: 'Transfer',
    title: 'Page weight',
    description:
      'Every byte your page ships has to be stored, transmitted, and rendered, and each step draws electricity. We measure how much data one visit to your homepage actually transfers, the single biggest factor in its footprint.',
  },
  {
    label: 'Carbon',
    title: 'CO₂ per visit',
    description:
      'Using the Sustainable Web Design Model, the peer-reviewed standard behind most digital carbon tools, that transfer converts into an estimate of grams of CO₂e emitted per page view, and an A+ to F rating.',
  },
  {
    label: 'Hosting',
    title: 'Green hosting check',
    description:
      'We check your domain against The Green Web Foundation\'s verified directory to see whether your site runs on renewable-powered infrastructure, or whether the greenest fix available is simply moving host.',
  },
];

const improvements = [
  {
    title: 'Compress and right-size your images',
    body: 'Images are the heaviest thing on most pages. Modern formats (WebP, AVIF), sensible dimensions, and lazy loading routinely cut page weight by half or more without any visible difference.',
    link: { href: '/services/development/', label: 'How we build lean sites' },
  },
  {
    title: 'Ship less JavaScript',
    body: 'Trackers, chat widgets, embedded fonts and framework bloat all cost carbon on every single visit. Static-first builds strip most of it out.',
    link: { href: '/services/development/', label: 'Static-first development' },
  },
  {
    title: 'Move to verified green hosting',
    body: 'The same site on renewable-powered infrastructure emits meaningfully less per visit, and it is usually the easiest change on this list. We migrate sites free on every hosting plan.',
    link: { href: '/services/green-web-hosting/', label: 'Managed green hosting from £9.99/month' },
  },
  {
    title: 'Design pages that say more with less',
    body: 'Auto-playing video backgrounds, carousels nobody swipes, five font families. A considered design brief is a sustainability decision. Leaner pages convert better too.',
    link: { href: '/services/web-design/', label: 'Considered web design' },
  },
];

const faqs = [
  {
    q: 'What does the website carbon audit measure?',
    a: 'The audit measures three things: how much data one visit to your page transfers (page weight), an estimate of the CO₂e emitted per page view calculated with the Sustainable Web Design Model, and whether your site runs on verified green hosting according to The Green Web Foundation\'s directory. You get an A+ to F digital carbon rating and a comparison against the other pages tested worldwide.',
  },
  {
    q: 'How accurate is the carbon estimate?',
    a: 'It is a modelled estimate, not a meter reading. No carbon tool can measure your exact emissions. The Sustainable Web Design Model is the most widely used methodology in the field: it combines data transfer with published figures for data centre, network, and device energy, and global grid carbon intensity. It is accurate enough to compare sites fairly and to track whether changes you make are working.',
  },
  {
    q: 'What is a good website carbon grade?',
    a: 'A or A+ means your page is in the top 10% of pages tested worldwide, under roughly 0.08 grams of CO₂e per visit. The median web page emits around 0.36 grams per visit, which rates an E. Anything at C or below usually has straightforward fixes available: oversized images, unused JavaScript, or fossil-fuelled hosting.',
  },
  {
    q: 'Is this audit really free?',
    a: 'Yes, completely. No signup, no email gate, no trial. Run as many URLs as you like. OakFox is a sustainable web studio; if your grade is poor we would obviously love to help fix it, but the tool itself asks nothing of you.',
  },
  {
    q: 'How do I reduce my website\'s carbon footprint?',
    a: 'In rough order of impact: compress and resize images (the biggest win on most sites), remove unnecessary JavaScript and third-party scripts, use system fonts or subset web fonts, switch to verified green hosting, enable caching and a CDN, and design pages with less on them. Most sites can halve their per-view emissions with a focused day of work.',
  },
  {
    q: 'Does a greener website load faster and rank better?',
    a: 'Almost always. The same things that cut carbon (smaller pages, less JavaScript, efficient images) are exactly what makes a site fast, and speed feeds directly into Core Web Vitals, which Google uses as a ranking signal. Lower bounce rates and better conversion follow. Green performance and commercial performance are the same work.',
  },
  {
    q: 'How do I know if my web hosting is green?',
    a: 'Check your domain against The Green Web Foundation\'s verified directory, which is exactly what this audit does. Verified green hosts have provided evidence that their infrastructure runs on renewable energy. Be wary of hosts that only claim "carbon neutrality" through offsets; that is not the same thing as running on renewables.',
  },
  {
    q: 'Why can\'t the audit reach my website?',
    a: 'Some security firewalls and website security plugins block every automated visitor, including our crawler. When that happens the audit automatically retries the measurement through Google Lighthouse, which almost every site allows. If both routes are blocked, send us the URL and we\'ll run the audit by hand. An over-aggressive firewall is worth knowing about anyway.',
  },
  {
    q: 'How is this different from the Website Carbon Calculator?',
    a: 'Same underlying science, independent measurement. We run our own crawler against your page, estimate emissions with co2.js, the open-source implementation of the Sustainable Web Design Model maintained by The Green Web Foundation, and check your hosting against the same foundation\'s verified directory, all in one pass. Then we add a plain-English verdict and practical next steps. And because OakFox is a working design and development studio, the advice comes from people who fix these problems for a living.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const journalPosts = [
  {
    href: '/blog/how-much-co2-does-a-website-produce/',
    title: 'How Much CO₂ Does a Website Produce?',
    note: 'What 100 UK audits say is normal, what counts as good, and what changes the number. Context for your grade.',
  },
  {
    href: '/blog/sustainable-web-design-practical-guide/',
    title: 'Sustainable Web Design: A Practical Guide',
    note: 'How to design and build low-carbon, accessible websites. The long version of the advice on this page.',
  },
  {
    href: '/blog/is-your-web-host-actually-green/',
    title: 'Is Your Web Host Actually Green?',
    note: 'Offsets versus renewables, and how to verify a hosting claim instead of taking it on faith.',
  },
  {
    href: '/blog/green-web-hosting-uk-compared/',
    title: 'Green Web Hosting in the UK, Compared',
    note: 'The main UK green hosts side by side. If your audit flagged your hosting, start here.',
  },
];

// Bar lengths for the grade ladder, against 0.40 g (F runs off the end).
const ladderWidth = (grade: string) =>
  ({ 'A+': 10, A: 20, B: 36, C: 52, D: 70, E: 90, F: 100 })[grade] ?? 100;
const gradeColour = (grade: string) => GRADE_COLORS[grade as keyof typeof GRADE_COLORS];

const why = [
  {
    title: 'The internet runs on electricity',
    body: "Data centres and transmission networks account for around 1 to 2% of global electricity use, and every page view draws on both. Your website's carbon footprint is real, recurring and, unlike most emissions, fixable in an afternoon.",
  },
  {
    title: 'Carbon and conversion are the same metric',
    body: "The changes that cut CO₂ (smaller images, less JavaScript, faster hosting) are the changes that cut load time. Faster pages bounce less, convert more, and score better on the Core Web Vitals that feed Google's rankings. There is no trade-off to weigh here.",
  },
  {
    title: "Claims are cheap. Evidence isn't",
    body: 'If sustainability is part of your brand, your website is the first place anyone can check the claim. A verifiable grade and green hosting you can prove beat a leaf icon in the footer every time.',
  },
];

const fixTones = [
  { card: 'bg-forest text-cream', link: 'text-leaf' },
  { card: 'bg-moss text-ink', link: 'text-forest' },
  { card: 'bg-ink text-cream', link: 'text-leaf' },
  { card: 'bg-cream-light border border-stone text-ink', link: 'text-forest' },
];

const ratings = study.ratings as Record<string, number>;
const aOrBetter = (ratings['A+'] ?? 0) + (ratings.A ?? 0);
const eOrF = (ratings.E ?? 0) + (ratings.F ?? 0);
---

<BaseLayout
  title="Free Website Carbon Audit: Check Your CO₂ Emissions"
  description="Free website carbon audit: see your site's carbon emissions per visit, page weight and green hosting in seconds, with an A+ to F grade. No signup, no email."
  schema={[webApplication, breadcrumbs, faqSchema]}
>
  <!-- ============ Hero: the tool itself, with this page's own reading beside it ============ -->
  <PageHero
    title="How green is your website?"
    accent="green"
    place="Free website carbon emissions audit"
    intro="Enter your web address for an instant carbon emissions audit: CO₂ per visit, page weight, a verified green hosting check and an A+ to F grade. Free, with no signup and no email."
    primary={null}
    secondary={null}
  >
    <div class="mt-9 max-w-2xl">
      <form id="audit-form" novalidate>
        <label for="audit-url" class="block text-[15px] font-semibold text-ink mb-3">Your website address</label>
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            id="audit-url"
            name="url"
            type="text"
            inputmode="url"
            autocomplete="url"
            spellcheck="false"
            placeholder="yourwebsite.co.uk"
            required
            class="flex-1 min-w-0 bg-white border border-ink/15 rounded-full px-6 py-4 text-[17px] text-ink placeholder:text-ink/65 focus:outline-none focus:border-forest focus:ring-2 focus:ring-forest/15 transition-colors duration-300"
          />
          <button id="audit-submit" type="submit" class="btn-primary btn-lg">Audit my site</button>
        </div>
      </form>
      <p id="audit-status" class="mt-4 text-[15px] text-ink/70 leading-relaxed min-h-[1.5rem]" role="status" aria-live="polite"></p>
    </div>
    <div slot="aside">
      <CarbonMeter heading="This page, measured as it loaded" showForm={false} />
    </div>
  </PageHero>

  <!-- ============ Results ============ -->
  <section id="audit-result" class="pb-16 md:pb-24 hidden scroll-mt-24" aria-live="polite">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="rounded-2xl border border-stone bg-cream-light p-7 md:p-12 relative overflow-hidden">
        <div id="confetti-host" class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true"></div>

        <div class="grid md:grid-cols-12 gap-10 md:gap-14 items-start relative z-10">
          <!-- Grade badge -->
          <div class="md:col-span-3 flex flex-col items-center md:items-start">
            <div id="grade-badge" class="w-36 h-36 md:w-44 md:h-44 rounded-full flex items-center justify-center bg-forest">
              <span id="grade-letter" class="text-cream font-semibold tracking-tight" style="font-size: clamp(3.5rem, 5vw, 5rem);">?</span>
            </div>
            <p class="mt-4 text-[14px] text-ink/65 text-center md:text-left">Digital carbon rating</p>
          </div>

          <!-- Verdict + stats -->
          <div class="md:col-span-9">
            <p class="text-[15px] text-ink/65 mb-2">Results for <span id="result-url" class="font-semibold text-ink"></span></p>
            <h2 id="verdict-title" class="headline text-3xl md:text-5xl text-ink"></h2>
            <p id="verdict-copy" class="mt-4 text-lg text-ink/70 leading-relaxed max-w-2xl"></p>

            <dl class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
              <div class="rounded-xl border border-stone bg-white/70 p-4">
                <dt class="text-[13px] text-ink/65 mb-1">CO₂ per visit</dt>
                <dd id="stat-co2" class="figures text-2xl md:text-3xl font-semibold tracking-tight text-ink">…</dd>
              </div>
              <div class="rounded-xl border border-stone bg-white/70 p-4">
                <dt class="text-[13px] text-ink/65 mb-1">Page weight</dt>
                <dd id="stat-weight" class="figures text-2xl md:text-3xl font-semibold tracking-tight text-ink">…</dd>
              </div>
              <div class="rounded-xl border border-stone bg-white/70 p-4">
                <dt class="text-[13px] text-ink/65 mb-1">Cleaner than</dt>
                <dd id="stat-cleaner" class="figures text-2xl md:text-3xl font-semibold tracking-tight text-ink">…</dd>
              </div>
              <div class="rounded-xl border border-stone bg-white/70 p-4">
                <dt class="text-[13px] text-ink/65 mb-1">Hosting</dt>
                <dd id="stat-hosting" class="figures text-2xl md:text-3xl font-semibold tracking-tight text-ink">…</dd>
              </div>
            </dl>
            <p id="stat-hosting-detail" class="mt-4 text-[14px] text-ink/65 leading-relaxed"></p>
            <p id="equiv-line" class="mt-5 text-[15px] text-ink/75 leading-relaxed border-l-2 border-forest pl-4"></p>
            <p id="cache-note" class="mt-4 text-[12px] text-ink/65 leading-relaxed hidden">
              Showing a saved result from the last hour.
              <button type="button" id="fresh-btn" class="text-forest underline underline-offset-4 hover:text-forest-dark transition-colors duration-300">Re-run a fresh audit</button>
              Handy if you've just made changes.
            </p>
            <p id="lighthouse-note" class="mt-4 text-[12px] text-ink/65 leading-relaxed hidden">
              This site's firewall blocks direct checks, so page weight was
              measured by Google Lighthouse instead. The same carbon model is
              applied to Google's numbers.
            </p>

            <!-- CTA: needs work -->
            <div id="cta-improve" class="mt-10 pt-8 border-t border-stone hidden">
              <h3 class="headline text-[22px] md:text-[26px] text-ink leading-tight">
                Get a free plan to improve this grade.
              </h3>
              <p class="mt-3 text-[14px] text-ink/70 leading-relaxed max-w-xl">
                Nathan will look at <span data-plan-host>your site</span> and reply
                within 24 hours with the three changes that would move its grade
                the most. No charge, no obligation, and you are free to make them
                yourself.
              </p>
              <form id="plan-form" class="mt-6 max-w-2xl" novalidate>
                <div class="flex flex-col sm:flex-row gap-3">
                  <label for="plan-name" class="sr-only">Your name</label>
                  <input
                    id="plan-name"
                    name="name"
                    type="text"
                    autocomplete="name"
                    maxlength="120"
                    placeholder="Your name"
                    required
                    class="flex-1 min-w-0 bg-white border border-stone rounded-full px-6 py-3.5 text-[15px] text-ink placeholder:text-gray focus:outline-none focus:border-forest transition-colors duration-300"
                  />
                  <label for="plan-email" class="sr-only">Your email</label>
                  <input
                    id="plan-email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    placeholder="you@yourbusiness.co.uk"
                    required
                    class="flex-1 min-w-0 bg-white border border-stone rounded-full px-6 py-3.5 text-[15px] text-ink placeholder:text-gray focus:outline-none focus:border-forest transition-colors duration-300"
                  />
                  <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="plan-hp" />
                  <button
                    id="plan-submit"
                    type="submit"
                    class="btn-primary"
                  >
                    Send me the plan
                  </button>
                </div>
                <p id="plan-status" class="mt-3 text-[13px] text-ink/65 leading-relaxed" role="status" aria-live="polite">
                  We only use your email to send the plan.
                </p>
              </form>
              <a
                id="cta-hosting-link"
                href="/services/green-web-hosting/"
                class="hidden mt-6 btn-outline"
              >
                Switch to green hosting, free migration
              </a>
            </div>

            <!-- CTA: celebration -->
            <div id="cta-celebrate" class="mt-10 hidden">
              <p class="text-[15px] text-ink/75 leading-relaxed max-w-xl">
                Genuinely brilliant. A low-carbon page on verified green
                hosting puts this site in rare company. Most of the web never
                gets close. Whoever built and hosts it deserves a biscuit.
              </p>
              <div class="mt-6 flex flex-wrap items-center gap-4">
                <button
                  id="share-btn"
                  type="button"
                  class="btn-primary"
                >
                  Copy link to these results
                </button>
                <a
                  href="/contact/"
                  class="btn-outline"
                >
                  Start a project
                </a>
              </div>
            </div>

            <!-- Badge withheld: good carbon grade, but something serious is broken -->
            <div id="cta-badge-withheld" class="mt-10 pt-8 border-t border-stone hidden">
              <h3 class="headline text-[22px] md:text-[26px] text-ink leading-tight">
                <span id="badge-withheld-grade">This page is light enough for the badge.</span>
              </h3>
              <p class="mt-3 text-[14px] text-ink/70 leading-relaxed max-w-xl">
                We are not issuing it yet, though, and it is worth explaining why.
                Weight is only half of a good website. These would need fixing
                first:
              </p>
              <ul id="badge-withheld-list" class="mt-5 space-y-2.5 max-w-2xl"></ul>
              <p class="mt-5 text-[13px] text-ink/65 leading-relaxed max-w-xl">
                A badge that vouched for a site with these outstanding would not
                mean much, so we would rather be straight with you about it.
              </p>
              <div class="mt-6">
                <a
                  id="badge-withheld-cta"
                  href="/contact/?service=carbon-audit"
                  class="btn-primary"
                >
                  Get a free plan to fix these
                </a>
              </div>
            </div>

            <!-- Badge: shown for A+, A and B in good technical health -->
            <div id="cta-badge" class="mt-10 pt-8 border-t border-stone hidden">
              <h3 class="headline text-[22px] md:text-[26px] text-ink leading-tight">
                This site has earned the badge.
              </h3>
              <p class="mt-3 text-[14px] text-ink/70 leading-relaxed max-w-xl">
                Anything rated B or better can display this. It links to a live
                re-run of this audit, so the rating a visitor checks is always
                measured fresh. There is nothing to keep updated, and nothing
                that can quietly go out of date.
              </p>

              <div class="mt-7 flex flex-wrap items-start gap-x-10 gap-y-7">
                <div>
                  <img
                    id="badge-preview"
                    src="/badge/carbon-a.svg"
                    alt="Badge preview"
                    width="200"
                    height="56"
                    class="block"
                  />
                  <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
                    <div class="flex flex-col gap-2">
                      <span class="text-[13px] text-ink/65">Style</span>
                      <div class="flex gap-1.5" role="group" aria-label="Badge style">
                        <button type="button" class="badge-opt" data-badge-theme="light" aria-pressed="true">Light</button>
                        <button type="button" class="badge-opt" data-badge-theme="dark" aria-pressed="false">Dark</button>
                      </div>
                    </div>
                    <div class="flex flex-col gap-2">
                      <span class="text-[13px] text-ink/65">Format</span>
                      <div class="flex gap-1.5" role="group" aria-label="Badge format">
                        <button type="button" class="badge-opt" data-badge-format="svg" aria-pressed="true">SVG</button>
                        <button type="button" class="badge-opt" data-badge-format="png" aria-pressed="false">PNG</button>
                      </div>
                    </div>
                  </div>
                  <p id="badge-format-note" class="mt-3 text-[12px] text-ink/65 max-w-[220px] leading-relaxed">
                    458 bytes. Lighter than a single line of text on most pages.
                  </p>
                </div>

                <div class="flex-1 min-w-[min(100%,300px)]">
                  <label
                    for="badge-embed"
                    class="block text-[13px] text-ink/65"
                  >
                    Paste this into your footer
                  </label>
                  <textarea
                    id="badge-embed"
                    readonly
                    rows="6"
                    spellcheck="false"
                    class="mt-2 w-full bg-cream border border-stone rounded-xl p-4 font-mono text-[11.5px] leading-relaxed text-ink/80 resize-y focus:outline-none focus:border-forest/50"
                  ></textarea>
                  <div class="mt-4 flex flex-wrap items-center gap-4">
                    <button
                      id="badge-copy"
                      type="button"
                      class="btn-primary"
                    >
                      Copy embed code
                    </button>
                    <a
                      href="/carbon-badge/"
                      class="text-[13px] text-forest underline underline-offset-4 hover:text-forest-dark transition-colors"
                    >
                      How the badge works
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Accessibility: the same address through A11yMate's free one-page check, on a11ymate.co.uk.
           Clicks are counted as the 'a11y' event, against 'audit' (results shown), in the dashboard. -->
      <div id="a11y-card" class="mt-6 rounded-2xl border border-stone bg-white/70 p-6 md:p-8 flex flex-col md:flex-row md:items-center gap-5 md:gap-8">
        <img src="/images/a11ymate/robot-head.svg" alt="" width="56" height="56" class="shrink-0" loading="lazy" />
        <div class="flex-1">
          <h3 class="headline text-[20px] md:text-[22px] text-ink leading-tight">Now check <span data-plan-host>your site</span> for accessibility.</h3>
          <p class="mt-2 text-[14px] text-ink/70 leading-relaxed max-w-2xl">
            The same page through A11yMate, our free accessibility checker: contrast, text size,
            headings, links, forms and more against WCAG 2.2, explained in plain English. Free,
            and nothing is stored.
          </p>
        </div>
        <a id="a11y-link" href="https://a11ymate.co.uk/check/" target="_blank" rel="noopener" class="btn-outline shrink-0">
          Check accessibility<span class="sr-only"> (opens a11ymate.co.uk in a new tab)</span>
        </a>
      </div>

      <p class="mt-6 text-[13px] text-ink/65 leading-relaxed max-w-3xl">
        Page weight is measured by OakFox's own crawler: your page plus the
        assets an initial view loads (lazy-loaded media excluded); real-browser
        weight can be slightly higher where scripts inject extra content. Carbon is estimated with
        <a href="https://www.thegreenwebfoundation.org/co2-js/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-forest">co2.js</a>
        and the Sustainable Web Design Model · hosting verified against
        <a href="https://www.thegreenwebfoundation.org" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-forest">The Green Web Foundation</a>'s
        directory. Results are modelled estimates for comparison, not meter readings.
      </p>
    </div>
  </section>

  <Pillars title="What the audit checks" items={checks.map((c) => ({ title: c.title, description: c.description }))} />

  <!-- ============ Grades, as a ladder ============ -->
  <section class="py-16 md:py-24 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 grid lg:grid-cols-12 gap-10 lg:gap-16">
