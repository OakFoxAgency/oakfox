  </section>

  <!-- ============ Why it matters ============ -->
  <section class="py-16 md:py-24 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <h2 class="headline text-4xl md:text-5xl max-w-[22ch]">A lighter site is a better business, not just a greener one.</h2>
      <div class="mt-10 md:mt-14 border-t border-stone">
        {why.map((w) => (
          <div class="reveal grid md:grid-cols-12 gap-3 md:gap-10 py-8 md:py-10 border-b border-stone">
            <h3 class="md:col-span-5 text-2xl md:text-3xl font-semibold tracking-tight leading-tight">{w.title}</h3>
            <p class="md:col-span-7 text-lg text-ink/70 leading-relaxed max-w-[60ch]">{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ How to improve ============ -->
  <section class="py-16 md:py-24 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <h2 class="headline text-4xl md:text-5xl">Four fixes, in order of impact</h2>
      <p class="mt-5 text-lg text-ink/70 leading-relaxed max-w-[60ch]">
        Most sites don't need a rebuild to move two grades. They need someone to
        do the unglamorous work below. Do it yourself with our
        <a href="/blog/sustainable-web-design-practical-guide/" class="text-forest underline underline-offset-4">practical guide</a>,
        or ask us for a free improvement plan.
      </p>
      <div class="mt-10 md:mt-12 grid md:grid-cols-2 gap-4 md:gap-5">
        {improvements.map((item, i) => (
          <div class={`reveal rounded-2xl p-7 md:p-9 flex flex-col ${fixTones[i % fixTones.length].card}`}>
            <h3 class="text-2xl md:text-3xl font-semibold tracking-tight">{item.title}</h3>
