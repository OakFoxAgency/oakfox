</style>

<script>
  // Grading lives in src/lib/carbon.mjs so the outreach CLI under
  // scripts/leads/ grades identically to this page — one model, one set of
  // bands, no drift between what a visitor sees and what we email them.
  import {
    GRADE_COLORS,
    estimateCarbon,
    cleanerThanFromGrams,
    gradeFromGrams,
    formatBytes,
    formatGrams,
    normaliseUrl,
    badgeSlug,
  } from '../lib/carbon.mjs';
  import { scoreSite, canDisplayBadge } from '../lib/site-health.mjs';

  const VERDICTS: Record<string, { title: string; copy: string }> = {
    great: {
      title: 'Genuinely brilliant.',
      copy: 'This page is lighter than at least 90% of the web and runs on verified green hosting. That combination is rare. Enjoy the confetti.',
    },
    leanUnknown: {
      title: 'Impressively lean.',
      copy: 'The page itself is in the top tier for weight and carbon. We could not reach the green hosting directory just now, so run the audit again in a minute for the full verdict.',
    },
    almostHosting: {
      title: 'So close to the full house.',
      copy: 'The page itself is impressively lean. The only thing standing between this site and bragging rights is the hosting underneath it. Moving to a verified green host is usually a one-day job, and we do migrations free.',
    },
    decent: {
      title: 'Decent, with easy wins left.',
      copy: 'This page is lighter than most of the web, but it is not lean yet. Sites in this band usually get to an A with image compression and a hard look at their scripts, often without touching the design.',
    },
    heavy: {
      title: 'Heavier than it needs to be.',
      copy: 'Every visit to this page emits more carbon than most of the web, and the same weight is slowing it down for visitors and search engines. The good news: grades this low usually have the most to gain from a few focused fixes.',
    },
  };

  const LOADING_MESSAGES = [
    'Fetching your page…',
    'Weighing every byte…',
    'Checking your host\'s energy supply…',
    'Crunching the carbon numbers…',
    'Nearly there. First-time audits take a little longer…',
  ];

  // Optional Google API key for the PageSpeed fallback. Keyless works using
  // each visitor's own per-IP quota; a key (restricted to the PageSpeed API +
  // this site's referrer) makes it fully reliable.
  const PSI_API_KEY = '';

  async function fetchLighthouseBytes(url: URL): Promise<{ bytes: number } | null> {
    try {
      const endpoint =
        `https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url=${encodeURIComponent(url.href)}` +
        `&category=performance${PSI_API_KEY ? `&key=${PSI_API_KEY}` : ''}`;
      const res = await fetchWithTimeout(endpoint, 70000);
      if (!res.ok) return null;
      const data = await res.json();
      const bytes = data?.lighthouseResult?.audits?.['total-byte-weight']?.numericValue;
      return typeof bytes === 'number' && bytes > 0 ? { bytes: Math.round(bytes) } : null;
    } catch {
      return null;
    }
  }

  function fetchWithTimeout(resource: string, timeoutMs: number): Promise<Response> {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    return fetch(resource, { signal: controller.signal }).finally(() => clearTimeout(timer));
  }

  function el<T extends HTMLElement>(id: string): T {
    return document.getElementById(id) as T;
  }

  function dropConfetti(): void {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const host = document.getElementById('confetti-host');
    if (!host) return;
    const colors = ['#1A5C12', '#4F7A1F', '#B07D10', '#F5F0E8', '#8A8680'];
    for (let i = 0; i < 70; i++) {
      const piece = document.createElement('span');
      piece.className = 'confetto';
      piece.style.left = `${Math.random() * 100}%`;
      piece.style.background = colors[i % colors.length];
      piece.style.animationDelay = `${Math.random() * 1.2}s`;
      piece.style.transform = `rotate(${Math.random() * 360}deg)`;
      host.appendChild(piece);
    }
    setTimeout(() => { host.innerHTML = ''; }, 5000);
  }

  let lastAuditedUrl: URL | null = null;

  // ---- Improvement plan request (posts to the contact form's endpoint) ----
  const plan = { host: '', summary: '', shownAt: 0 };
  const PLAN_NOTE = 'We only use your email to send the plan.';

  function resetPlanForm(): void {
    const status = document.getElementById('plan-status');
    if (!status) return;
    status.textContent = PLAN_NOTE;
    delete status.dataset.state;
  }

  async function sendPlanRequest(form: HTMLFormElement): Promise<void> {
    const status = el<HTMLParagraphElement>('plan-status');
    const button = el<HTMLButtonElement>('plan-submit');
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    if (!name || !email) {
      status.textContent = 'Add your name and email and we will send it over.';
      status.dataset.state = 'error';
      return;
    }
    data.set('message', plan.summary);
    data.append('services[]', 'Carbon audit plan');
    data.set('elapsed_ms', String(Date.now() - plan.shownAt));
    for (const key of ['gclid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content']) {
      const value = sessionStorage.getItem('oakfox_' + key);
      if (value) data.set(key, value);
    }

    button.disabled = true;
    button.textContent = 'Sending…';
    try {
      const response = await fetch('/api/contact.php', { method: 'POST', body: data });
      const result = await response.json().catch(() => ({}));
      if (response.ok && result.success) {
        status.textContent = `Thanks, ${name}. The plan for ${plan.host} will be in your inbox within 24 hours.`;
        status.dataset.state = 'ok';
        window.oakfoxTrack?.('plan');
        if (window.gtag && window.__awConversionIds?.contact) {
          window.gtag('event', 'conversion', { send_to: window.__awConversionIds.contact });
        }
        form.reset();
      } else {
        status.textContent = result.error || 'Something went wrong. Please email nathan@oakfox.co.uk instead.';
        status.dataset.state = 'error';
      }
    } catch {
      status.textContent = 'Network error. Please email nathan@oakfox.co.uk instead.';
      status.dataset.state = 'error';
    }
    button.disabled = false;
    button.textContent = 'Send me the plan';
  }

  async function runAudit(url: URL, fresh = false): Promise<void> {
    // Every audit counts, whether it started here, from a site-wide band or a
    // shared ?url= link. Not re-runs, and not our own footer badge.
    if (!fresh && url.hostname.replace(/^www\./, '') !== 'oakfox.co.uk') window.oakfoxTrack?.('audit');

    const status = el<HTMLParagraphElement>('audit-status');
    const result = el<HTMLElement>('audit-result');
    const submit = el<HTMLButtonElement>('audit-submit');

    submit.disabled = true;
    submit.style.opacity = '0.6';
    result.classList.add('hidden');

    let messageIndex = 0;
    status.textContent = LOADING_MESSAGES[0];
    const rotate = setInterval(() => {
      messageIndex = Math.min(messageIndex + 1, LOADING_MESSAGES.length - 1);
      status.textContent = LOADING_MESSAGES[messageIndex];
    }, 4000);

    // Hosting check (fast) and carbon estimate (can take a while on a cold
    // run — the API has to fetch and weigh the page) fired in parallel.
    const greenPromise = fetchWithTimeout(
      `https://api.thegreenwebfoundation.org/api/v3/greencheck/${encodeURIComponent(url.hostname)}`,
      15000,
    ).then((r) => (r.ok ? r.json() : null)).catch(() => null);

    let carbon: any = null;
    let carbonError: 'rate-limit' | 'failed' | 'blocked' | null = null;
    try {
      const response = await fetchWithTimeout(
        `/api/carbon-audit.php?url=${encodeURIComponent(url.href)}${fresh ? '&fresh=1' : ''}`,
        75000,
      );
      if (response.status === 429) carbonError = 'rate-limit';
      else {
        const payload = await response.json().catch(() => null);
        if (payload?.ok) carbon = payload;
        else carbonError = payload?.error === 'blocked' ? 'blocked' : 'failed';
      }
    } catch {
      carbonError = 'failed';
    }

    // Firewalls that block our server by IP almost never block Google,
    // fall back to Lighthouse via the PageSpeed Insights API, called from
    // the visitor's own browser.
    let viaLighthouse = false;
    if (carbonError === 'blocked') {
      clearInterval(rotate);
      status.textContent =
        'Their firewall blocks direct checks. Asking Google Lighthouse instead. This can take up to a minute…';
      const psi = await fetchLighthouseBytes(url);
      if (psi) {
        carbon = { ok: true, bytes: psi.bytes, cached: false };
        carbonError = null;
        viaLighthouse = true;
      }
    }

    const green = await greenPromise;
    clearInterval(rotate);
    submit.disabled = false;
    submit.style.opacity = '';

    if (!carbon || typeof carbon.bytes !== 'number') {
      let message =
        carbonError === 'rate-limit'
          ? 'That\'s a lot of audits in one minute. Give it a moment and try again.'
          : carbonError === 'blocked'
            ? `That site's firewall blocks automated checks, and Google's Lighthouse fallback was busy too. Try again in a few minutes, or `
            : `We couldn't audit that address. Check the URL is public and loading, then try again, or `;
      status.innerHTML = '';
      status.append(message);
      if (carbonError !== 'rate-limit') {
        const link = document.createElement('a');
        link.href = '/contact/';
        link.className = 'text-forest underline underline-offset-4';
        link.textContent = 'send it to us and we\'ll run it by hand';
        status.append(link, '.');
      }
      if (green && typeof green.green === 'boolean') {
        status.append(
          ` One thing we did learn: ${url.hostname} ${green.green ? 'is on verified green hosting, a strong start.' : 'is not in the verified green hosting directory.'}`,
        );
      }
      return;
    }

    // ---- Derive the numbers ----
    const greenKnown: boolean = !!(green && typeof green.green === 'boolean');
    const isGreenHost: boolean = greenKnown ? green.green : false;
    const { grams, rating } = estimateCarbon(carbon.bytes, isGreenHost);
    const grade: string = rating ?? gradeFromGrams(grams);
    const cleanerThan: number | null = cleanerThanFromGrams(grams);

    // ---- Populate the card ----
    lastAuditedUrl = url;
    el<HTMLElement>('cache-note').classList.toggle('hidden', carbon.cached !== true);
    el<HTMLElement>('lighthouse-note').classList.toggle('hidden', !viaLighthouse);
    el<HTMLSpanElement>('result-url').textContent = url.hostname;
    el<HTMLSpanElement>('grade-letter').textContent = grade;
    el<HTMLDivElement>('grade-badge').style.backgroundColor = GRADE_COLORS[grade] ?? GRADE_COLORS.F;
    el<HTMLElement>('stat-co2').textContent = formatGrams(grams);
    el<HTMLElement>('stat-weight').textContent = formatBytes(carbon.bytes);
    el<HTMLElement>('stat-cleaner').textContent = cleanerThan !== null ? `${cleanerThan}% of pages` : 'Below median';
    el<HTMLElement>('stat-hosting').textContent = isGreenHost ? 'Green ✓' : greenKnown ? 'Not green' : 'Unknown';
    el<HTMLElement>('stat-hosting-detail').textContent = isGreenHost
      ? `Verified green hosting${green?.hosted_by ? `, hosted by ${green.hosted_by}` : ''} (The Green Web Foundation directory).`
      : greenKnown
        ? `No verified green hosting evidence found for ${url.hostname} in The Green Web Foundation directory.`
        : 'We could not reach the green hosting directory just now. Try again shortly for the hosting result.';

    const annualKg = (grams * 120000) / 1000; // 10k visits/month for a year
    const carKm = Math.round((annualKg * 1000) / 170); // ~170 g CO2e per petrol-car km
    el<HTMLElement>('equiv-line').textContent =
      `At 10,000 visits a month, this page would emit roughly ${annualKg.toFixed(1)} kg of CO₂e a year, about the same as driving ${carKm.toLocaleString()} km in a petrol car.`;

    // ---- Verdict + CTA state ----
    const isLean = grade === 'A+' || grade === 'A';
    let verdict;
    if (isLean && isGreenHost) verdict = VERDICTS.great;
    else if (isLean && greenKnown) verdict = VERDICTS.almostHosting;
    else if (isLean) verdict = VERDICTS.leanUnknown;
    else if (grade === 'B' || grade === 'C') verdict = VERDICTS.decent;
    else verdict = VERDICTS.heavy;

    el<HTMLElement>('verdict-title').textContent = verdict.title;
    el<HTMLElement>('verdict-copy').textContent = verdict.copy;

    const celebrate = isLean && isGreenHost;
    el<HTMLElement>('cta-celebrate').classList.toggle('hidden', !celebrate);
    el<HTMLElement>('cta-improve').classList.toggle('hidden', celebrate);
    const offerHostingSwitch = greenKnown && !isGreenHost;
    const hostingLink = el<HTMLAnchorElement>('cta-hosting-link');
    hostingLink.classList.toggle('hidden', !offerHostingSwitch);
    hostingLink.classList.toggle('inline-flex', offerHostingSwitch);
    // Shareable URL for these results.
    const shareUrl = `${window.location.origin}${window.location.pathname}?url=${encodeURIComponent(url.hostname)}`;
    history.replaceState(null, '', shareUrl);

    // Badge: a good carbon grade is necessary but not sufficient. A light page
    // can still be a broken one, so the technical signals get a say too.
    const health = scoreSite(carbon.signals, {
      grade,
      grams,
      bytes: carbon.bytes,
      requests: carbon.requests,
    });
    const badge = canDisplayBadge(grade, health);
    badgeState.grade = grade;
    badgeState.hostname = url.hostname;
    el<HTMLElement>('cta-badge').classList.toggle('hidden', !badge.allowed);
    el<HTMLElement>('cta-badge-withheld').classList.toggle('hidden', badge.allowed || !badge.blockers.length);
    if (badge.allowed) renderBadgeEmbed();
    else if (badge.blockers.length) renderBadgeWithheld(badge.blockers, grade);

    // What a plan request sends Nathan: the numbers this visitor just saw.
    // No scheme or www. in the message, or contact.php flags it as spam.
    plan.host = url.hostname.replace(/^www\./, '');
    plan.summary = [
      'Free improvement plan request from the website carbon audit.',
      '',
      `Site: ${plan.host}`,
      `Grade: ${grade}`,
      `CO2 per visit: ${formatGrams(grams)}`,
      `Page weight: ${formatBytes(carbon.bytes)}`,
      `Hosting: ${isGreenHost ? 'verified green' : greenKnown ? 'not verified green' : 'unknown'}`,
      ...(badge.blockers.length ? [`Also found: ${badge.blockers.map((b) => b.label).join('; ')}`] : []),
    ].join('\n');
    plan.shownAt = Date.now();
    document.querySelectorAll('[data-plan-host]').forEach((node) => { node.textContent = plan.host; });
    el<HTMLAnchorElement>('a11y-link').href = `https://a11ymate.co.uk/check/?url=${encodeURIComponent(url.href)}`;
    resetPlanForm();

    status.textContent = '';
    result.classList.remove('hidden');
    result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    if (celebrate) dropConfetti();
  }

  // ---- Embeddable badge ----
  const badgeState = {
    grade: 'A',
    hostname: '',
    theme: 'light' as 'light' | 'dark',
    format: 'svg' as 'svg' | 'png',
  };

  function renderBadgeEmbed(): void {
    const file = `carbon-${badgeSlug(badgeState.grade)}${badgeState.theme === 'dark' ? '-dark' : ''}.${badgeState.format}`;
    const origin = 'https://oakfox.co.uk';

    const preview = el<HTMLImageElement>('badge-preview');
    preview.src = `/badge/${file}`;
    preview.alt = `Carbon rating ${badgeState.grade} badge, ${badgeState.theme} style`;

    // &amp; in the href because this is markup someone pastes into a page, and
    // a bare & in an attribute is invalid HTML. The alt text deliberately
    // carries the grade but no gram figure: they paste this once and never
    // revisit it, so any number in it would slowly become a lie.
    const link = `${origin}/website-carbon-audit?url=${encodeURIComponent(badgeState.hostname)}&amp;utm_source=badge`;
    el<HTMLTextAreaElement>('badge-embed').value =
      '<!-- Carbon rating badge · oakfox.co.uk -->\n' +
      `<a href="${link}" target="_blank" rel="noopener">\n` +
      `  <img src="${origin}/badge/${file}"\n` +
      `       alt="Carbon rating ${badgeState.grade}, website carbon audit by OakFox"\n` +
      '       width="200" height="56" loading="lazy" decoding="async">\n' +
      '</a>';

    el<HTMLElement>('badge-format-note').textContent =
      badgeState.format === 'svg'
        ? '458 bytes. Lighter than a single line of text on most pages.'
        : '7.3 KB at 2x. Use this only if your site builder refuses SVG uploads. Wix and Squarespace both do in places.';
  }

  function renderBadgeWithheld(blockers: Array<{ label: string; pitch: string }>, grade: string): void {
    el<HTMLElement>('badge-withheld-grade').textContent =
      `A grade of ${grade} is light enough for the badge.`;

    const list = el<HTMLUListElement>('badge-withheld-list');
    list.replaceChildren(
      ...blockers.map((b) => {
        const li = document.createElement('li');
        li.className = 'flex gap-3 text-[14px] text-ink/80 leading-relaxed';
        const dot = document.createElement('span');
        dot.className = 'shrink-0 w-1.5 h-1.5 rounded-full bg-[#B25714] mt-2';
        const copy = document.createElement('span');
        // The pitch reads as a sentence to the site's owner, which is exactly
        // who is looking at this panel.
        copy.textContent = `${b.label}: ${b.pitch}`;
        li.append(dot, copy);
        return li;
      })
    );

    el<HTMLAnchorElement>('badge-withheld-cta').href =
      `/contact/?service=carbon-audit&audit=${encodeURIComponent(badgeState.hostname)}&grade=${encodeURIComponent(grade)}`;
  }

  function initBadgeControls(): void {
    document.querySelectorAll<HTMLButtonElement>('[data-badge-theme]').forEach((btn) => {
      btn.addEventListener('click', () => {
        badgeState.theme = btn.dataset.badgeTheme === 'dark' ? 'dark' : 'light';
        document
          .querySelectorAll<HTMLButtonElement>('[data-badge-theme]')
          .forEach((sib) => sib.setAttribute('aria-pressed', String(sib === btn)));
        renderBadgeEmbed();
      });
    });

    document.querySelectorAll<HTMLButtonElement>('[data-badge-format]').forEach((btn) => {
      btn.addEventListener('click', () => {
        badgeState.format = btn.dataset.badgeFormat === 'png' ? 'png' : 'svg';
        document
          .querySelectorAll<HTMLButtonElement>('[data-badge-format]')
          .forEach((sib) => sib.setAttribute('aria-pressed', String(sib === btn)));
        renderBadgeEmbed();
      });
    });

    document.getElementById('badge-copy')?.addEventListener('click', async () => {
      const btn = document.getElementById('badge-copy')!;
      const field = el<HTMLTextAreaElement>('badge-embed');
      try {
        await navigator.clipboard.writeText(field.value);
        btn.textContent = 'Copied ✓';
      } catch {
        // Clipboard API needs a secure context and permission; selecting the
        // text at least leaves the user one keystroke away.
        field.focus();
        field.select();
        btn.textContent = 'Selected. Press Cmd/Ctrl+C';
      }
      setTimeout(() => { btn.textContent = 'Copy embed code'; }, 2500);
    });
  }

  function initAudit(): void {
    const form = document.getElementById('audit-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound === '1') return;
    form.dataset.bound = '1';

    const input = el<HTMLInputElement>('audit-url');
    const status = el<HTMLParagraphElement>('audit-status');

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const url = normaliseUrl(input.value);
      if (!url) {
        status.textContent = 'That doesn\'t look like a web address. Try something like yourwebsite.co.uk';
        return;
      }
      runAudit(url);
    });

    document.getElementById('fresh-btn')?.addEventListener('click', () => {
      if (lastAuditedUrl) runAudit(lastAuditedUrl, true);
    });

    // Measured against 'audit': how many people who see a carbon result go on to check accessibility.
    document.getElementById('a11y-link')?.addEventListener('click', () => {
      window.oakfoxTrack?.('a11y');
    });

    const planForm = document.getElementById('plan-form') as HTMLFormElement | null;
    planForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      sendPlanRequest(planForm);
    });

    initBadgeControls();

    document.getElementById('share-btn')?.addEventListener('click', async () => {
      const btn = document.getElementById('share-btn')!;
      try {
        await navigator.clipboard.writeText(window.location.href);
        btn.textContent = 'Link copied ✓';
        setTimeout(() => { btn.textContent = 'Copy link to these results'; }, 2500);
      } catch {
        btn.textContent = window.location.href;
      }
    });

    // Shareable / linkable audits: ?url=example.com auto-runs on load.
    const preset = new URLSearchParams(window.location.search).get('url');
    if (preset) {
      const url = normaliseUrl(preset);
      if (url) {
        input.value = url.hostname;
        runAudit(url);
      }
    }
  }

  document.addEventListener('astro:page-load', initAudit);
  if (document.readyState !== 'loading') initAudit();
  else document.addEventListener('DOMContentLoaded', initAudit, { once: true });
</script>
