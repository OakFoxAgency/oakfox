---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Img from '../../components/Img.astro';
import { getCollection } from 'astro:content';

const allWork = (await getCollection('portfolio'))
  .sort(
    (a, b) =>
      (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
      b.data.date.valueOf() - a.data.date.valueOf()
  );

const categoryNames: Record<string, string> = {
  branding: 'Branding',
  design: 'Brand and web design',
  development: 'Design and development',
  marketing: 'Marketing',
  consultancy: 'Research',
};
const categories = ['all', ...new Set(allWork.map((item) => item.data.category))];

const year = (d: Date) => d.getFullYear();

const pageUrl = 'https://oakfox.co.uk/portfolio';

const collectionSchema = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: 'OakFox work: branding, web design and development',
  description:
    'Selected case studies from OakFox: apps designed, built and shipped in-house, client web design and development, free sustainability tools, and original research.',
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://oakfox.co.uk/#website' },
  hasPart: allWork.map((item) => ({
    '@type': 'CreativeWork',
    name: item.data.title,
    description: item.data.description,
    url: `https://oakfox.co.uk/portfolio/${item.id}`,
    genre: item.data.category,
  })),
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Portfolio', item: pageUrl },
  ],
};
---

<BaseLayout
  title="Work: Branding, Web Design and Development Case Studies"
  description="Selected case studies from OakFox: shipped iOS and Android apps, sustainable web design and development for UK independents, free tools and original research."
  schema={[collectionSchema, breadcrumbs]}
>
  <PageHero
    title="Selected work"
    intro="Apps we've designed, built and shipped ourselves, websites for real clients, free tools, and original research published in the open. Almost all of it is live, so you can try it now."
    primary={null}
    secondary={null}
  >
    <div class="mt-10 flex flex-wrap gap-2" id="portfolio-filters" role="group" aria-label="Filter work by type">
      {categories.map((cat) => (
        <button type="button" data-filter={cat} aria-pressed={cat === 'all' ? 'true' : 'false'} class="filter-pill">
          {cat === 'all' ? 'All work' : categoryNames[cat] ?? cat}
        </button>
      ))}
    </div>
  </PageHero>

  <section class="pb-20 md:pb-28">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      {allWork.length > 0 ? (
        <!-- One system: the lead project as a full-width feature, then an even
             two-column grid. Every image sits in the same 16:10 frame, so rows
             line up, and filtering just reflows the grid. -->
        <div class="grid md:grid-cols-2 gap-x-6 md:gap-x-8 gap-y-14 md:gap-y-16" id="portfolio-grid">
          {allWork.map((item, i) => (
            i === 0 ? (
              <a href={`/portfolio/${item.id}/`} class="group md:col-span-2 grid lg:grid-cols-12 gap-6 lg:gap-10 items-end" data-category={item.data.category}>
                <div class="lg:col-span-8 img-wrap rounded-2xl bg-moss aspect-[16/10]">
                  <Img src={item.data.thumbnail} alt={item.data.title} loading="eager" class="w-full h-full object-cover object-top" />
                </div>
                <div class="lg:col-span-4 lg:pb-2">
                  <p class="label text-ink/60">{categoryNames[item.data.category] ?? item.data.category}, {year(item.data.date)}</p>
                  <h2 class="mt-3 text-3xl md:text-5xl font-semibold tracking-tight leading-[1.05] group-hover:text-forest transition-colors">{item.data.title}</h2>
                  <p class="mt-4 text-lg text-ink/70 leading-relaxed">{item.data.description}</p>
                  <span class="mt-6 inline-flex items-center gap-2 text-[15px] font-medium text-forest">
                    Read the case study
                    <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                </div>
              </a>
            ) : (
              <a href={`/portfolio/${item.id}/`} class="group flex flex-col" data-category={item.data.category}>
                <div class="img-wrap rounded-2xl bg-moss aspect-[16/10]">
                  <Img src={item.data.thumbnail} alt={item.data.title} class="w-full h-full object-cover object-top" />
                </div>
                <p class="mt-5 label text-ink/60">{categoryNames[item.data.category] ?? item.data.category}, {year(item.data.date)}</p>
                <h2 class="mt-2 text-2xl md:text-3xl font-semibold tracking-tight group-hover:text-forest transition-colors">{item.data.title}</h2>
                <p class="mt-2 text-base md:text-lg text-ink/70 leading-relaxed line-clamp-2">{item.data.description}</p>
              </a>
            )
          ))}
        </div>
      ) : (
        <p class="text-ink/65 py-12">New case studies are on the way.</p>
      )}
    </div>
  </section>

  <CtaBlock title="Like what you see?" text="Tell us about your project. We reply within 24 hours." />
</BaseLayout>

<style>
  .filter-pill {
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--color-stone);
    background: var(--color-cream-light);
    font-size: 0.9375rem;
    font-weight: 500;
    color: color-mix(in oklab, var(--color-ink) 75%, transparent);
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }
  .filter-pill:hover { border-color: var(--color-forest); color: var(--color-forest); }
  .filter-pill[aria-pressed='true'] {
    background: var(--color-forest);
    border-color: var(--color-forest);
    color: var(--color-cream);
  }
</style>

<script>
  function initPortfolioFilters() {
    const filters = document.querySelectorAll<HTMLButtonElement>('#portfolio-filters button');
    if (!filters.length) return;
    const items = document.querySelectorAll<HTMLAnchorElement>('#portfolio-grid > a');

    filters.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        filters.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        items.forEach((item) => {
          const cat = item.getAttribute('data-category');
          item.style.display = filter === 'all' || cat === filter ? '' : 'none';
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initPortfolioFilters);
</script>
