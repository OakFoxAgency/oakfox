---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Img from '../../components/Img.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const items = (await getCollection('portfolio')).sort(
    (a, b) =>
      (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
      b.data.date.valueOf() - a.data.date.valueOf()
  );
  // Previous and next follow the order of the work page, wrapping round.
  return items.map((item, i) => ({
    params: { id: item.id },
    props: {
      item,
      prev: items[(i - 1 + items.length) % items.length],
      next: items[(i + 1) % items.length],
    },
  }));
}

const { item, prev, next } = Astro.props;
const { Content } = await render(item);

const categoryServiceMap: Record<string, { href: string; label: string }> = {
  branding: { href: '/services/branding/', label: 'Branding' },
  design: { href: '/services/web-design/', label: 'Web design' },
  development: { href: '/services/development/', label: 'Development' },
  marketing: { href: '/services/marketing/', label: 'Marketing' },
  consultancy: { href: '/services/environmental/', label: 'Environmental consultancy' },
};
const categoryNames: Record<string, string> = {
  branding: 'Branding',
  design: 'Brand and web design',
  development: 'Design and development',
  marketing: 'Marketing',
  consultancy: 'Research',
};
const relatedService = categoryServiceMap[item.data.category];
const year = item.data.date.getFullYear();

const projectUrl = `https://oakfox.co.uk/portfolio/${item.id}`;
const projectSchema: Record<string, unknown> = {
  '@type': 'CreativeWork',
  '@id': `${projectUrl}#project`,
  name: item.data.title,
  headline: item.data.title,
  description: item.data.description,
  url: projectUrl,
  image: new URL(item.data.thumbnail, 'https://oakfox.co.uk').toString(),
  datePublished: item.data.date.toISOString(),
  inLanguage: 'en-GB',
  genre: item.data.category,
  keywords: item.data.tags.join(', '),
  creator: { '@id': 'https://oakfox.co.uk/#organization' },
  publisher: { '@id': 'https://oakfox.co.uk/#organization' },
};

if (item.data.client) {
  projectSchema.sourceOrganization = { '@type': 'Organization', name: item.data.client };
}

if (item.data.testimonial) {
  projectSchema.review = {
    '@type': 'Review',
    reviewBody: item.data.testimonial.quote,
    author: {
      '@type': 'Person',
      name: item.data.testimonial.author,
      ...(item.data.testimonial.role ? { jobTitle: item.data.testimonial.role } : {}),
    },
  };
}

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Work', item: 'https://oakfox.co.uk/portfolio' },
    { '@type': 'ListItem', position: 3, name: item.data.title, item: projectUrl },
  ],
};
---

<BaseLayout
  title={item.data.seoTitle ?? item.data.title}
  description={item.data.description}
  image={item.data.thumbnail}
  type="article"
  schema={[projectSchema, breadcrumbs]}
>
  <article>
    <!-- Header: title and summary, then the work itself, full width. -->
    <header data-scene="hero" class="max-w-[1400px] mx-auto px-6 md:px-10 pt-28 md:pt-36">
      <a href="/portfolio/" class="inline-flex items-center gap-2 mb-6 text-[14px] font-medium text-ink/60 hover:text-forest transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        All work
      </a>
      <div class="grid lg:grid-cols-12 gap-y-6 lg:gap-x-16 items-end">
        <h1 class="headline case-title text-ink lg:col-span-7">
          {item.data.title.split(' ').map((w, i, a) => (
            <><span class="split-word"><span>{w}</span></span>{i < a.length - 1 && ' '}</>
          ))}
        </h1>
        <p data-hero-paragraph class="lg:col-span-5 text-lg md:text-xl text-ink/70 leading-relaxed">{item.data.description}</p>
      </div>
      <!-- Not animated in: it's the page's largest paint. -->
      <div class="mt-10 md:mt-14 rounded-2xl overflow-hidden bg-moss">
        <Img src={item.data.thumbnail} alt={item.data.title} loading="eager" class="w-full h-auto" />
      </div>
    </header>

    <!-- Meta strip -->
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <dl class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-6 border-y border-stone py-7">
        <div>
          <dt class="text-[13px] text-ink/55">Type of work</dt>
          <dd class="mt-1 text-[15px] font-medium text-ink">
            {relatedService ? <a href={relatedService.href} class="hover:text-forest underline decoration-ink/20 underline-offset-4">{categoryNames[item.data.category]}</a> : categoryNames[item.data.category]}
          </dd>
        </div>
        <div>
          <dt class="text-[13px] text-ink/55">Year</dt>
          <dd class="mt-1 text-[15px] font-medium text-ink figures">{year}</dd>
        </div>
        {item.data.client && (
          <div>
            <dt class="text-[13px] text-ink/55">Client</dt>
            <dd class="mt-1 text-[15px] font-medium text-ink">{item.data.client}</dd>
          </div>
        )}
        {item.data.tags.length > 0 && (
          <div class={item.data.client ? '' : 'md:col-span-2'}>
            <dt class="text-[13px] text-ink/55">What we did</dt>
            <dd class="mt-2 flex flex-wrap gap-1.5">
              {item.data.tags.map((tag: string) => (
                <span class="px-2.5 py-1 rounded-full bg-moss text-[13px] text-ink/80">{tag}</span>
              ))}
            </dd>
          </div>
        )}
      </dl>
    </div>

    {item.data.outcomes.length > 0 && (
      <section class="max-w-[1400px] mx-auto px-6 md:px-10 mt-14 md:mt-20">
        <h2 class="headline text-3xl md:text-4xl">What came of it</h2>
        <ul class="mt-8 grid md:grid-cols-3 gap-4 md:gap-5">
          {item.data.outcomes.map((outcome: string, i: number) => (
            <li class={`reveal rounded-2xl p-6 md:p-7 text-lg leading-snug ${i === 0 ? 'bg-forest text-cream' : 'bg-cream-light border border-stone text-ink/85'}`}>
              {outcome}
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- The story: prose at a reading measure, with the related service beside it. -->
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 mt-14 md:mt-20 pb-16 md:pb-24 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="min-w-0 lg:col-span-8 lg:order-2">
        <div class="prose-oak prose prose-lg max-w-[68ch]">
          <Content />
        </div>

        {item.data.testimonial && (
          <figure class="mt-16 md:mt-20 rounded-2xl bg-moss p-8 md:p-12">
            <blockquote class="text-2xl md:text-3xl font-semibold tracking-tight leading-snug text-ink">
              “{item.data.testimonial.quote}”
            </blockquote>
            <figcaption class="mt-6 text-[15px]">
              <span class="font-semibold text-ink">{item.data.testimonial.author}</span>
              {item.data.testimonial.role && <span class="text-ink/65">, {item.data.testimonial.role}</span>}
            </figcaption>
          </figure>
        )}
      </div>

      <aside class="lg:col-span-3 lg:order-1">
        <div class="lg:sticky lg:top-28 space-y-6">
          {relatedService && (
            <div class="rounded-2xl border border-stone bg-cream-light p-6">
              <p class="text-[13px] text-ink/55">The service behind it</p>
              <a href={relatedService.href} class="group mt-2 inline-flex items-center gap-2 text-lg font-semibold text-ink hover:text-forest transition-colors">
                {relatedService.label}
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            </div>
          )}
          <a href="/contact/" class="btn-primary w-full">Start a project</a>
        </div>
      </aside>
    </div>
  </article>

  <!-- More work -->
  <section class="border-t border-stone py-16 md:py-24">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <div class="flex items-end justify-between gap-6 mb-8 md:mb-10">
        <h2 class="headline text-4xl md:text-5xl">More work</h2>
        <a href="/portfolio/" class="link-line text-[15px] font-medium text-ink hover:text-forest transition-colors">All work</a>
      </div>
      <div class="grid md:grid-cols-2 gap-8 md:gap-10">
        {[{ entry: prev, label: 'Previous' }, { entry: next, label: 'Next' }].map(({ entry, label }) => (
          <a href={`/portfolio/${entry.id}/`} class="group block">
            <div class="img-wrap rounded-2xl bg-moss aspect-[16/10]">
              <Img src={entry.data.thumbnail} alt={entry.data.title} class="w-full h-full object-cover object-top" />
            </div>
            <p class="mt-5 text-[13px] text-ink/55">{label}</p>
            <h3 class="mt-1 text-2xl md:text-3xl font-semibold tracking-tight group-hover:text-forest transition-colors">{entry.data.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBlock
    title="Want something like this?"
    text="Tell us what you're working on and where it needs to get to. We reply within 24 hours."
  />
</BaseLayout>

<style>
  .case-title {
    font-size: clamp(2.6rem, 6vw, 5.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  /* MDX content in the new type: a larger body, firm headings, tables and
     quotes that belong to the site rather than to the typography plugin. */
  .prose-oak {
    --tw-prose-body: color-mix(in oklab, var(--color-ink) 82%, transparent);
    --tw-prose-headings: var(--color-ink);
    --tw-prose-links: var(--color-forest);
    --tw-prose-bold: var(--color-ink);
    --tw-prose-bullets: var(--color-forest);
    --tw-prose-counters: var(--color-forest);
    --tw-prose-quotes: var(--color-ink);
    --tw-prose-quote-borders: var(--color-forest);
    --tw-prose-hr: var(--color-stone);
    --tw-prose-th-borders: var(--color-stone);
    --tw-prose-td-borders: var(--color-stone);
    font-size: 1.1875rem;
    line-height: 1.7;
  }
  .prose-oak :global(h2) { font-size: 2rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; margin-top: 2.4em; }
  .prose-oak :global(h3) { font-size: 1.4rem; font-weight: 600; letter-spacing: -0.015em; }
  .prose-oak :global(h4) { font-weight: 600; }
  .prose-oak :global(a) { text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .prose-oak :global(a:hover) { color: var(--color-forest-dark); }
  .prose-oak :global(blockquote) {
    font-style: normal;
    font-weight: 500;
    font-size: 1.3em;
    line-height: 1.45;
    padding-left: 1.25em;
  }
  .prose-oak :global(blockquote p::before),
  .prose-oak :global(blockquote p::after) { content: none; }
  .prose-oak :global(img) { border-radius: 1rem; }
  .prose-oak :global(table) { font-size: 0.875em; display: block; max-width: 100%; overflow-x: auto; }
  .prose-oak :global(thead th) { font-weight: 600; }
  .prose-oak :global(code) { font-weight: 500; }
</style>
