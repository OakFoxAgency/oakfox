---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/posts';

const posts = (await getCollection('blog', isPublished))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [lead, ...rest] = posts;

const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const topTags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12);

const date = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const searchData = (post: (typeof posts)[number]) => ({
  'data-title': post.data.title.toLowerCase(),
  'data-description': post.data.description.toLowerCase(),
  'data-tags': post.data.tags.join(' ').toLowerCase(),
  'data-category': post.data.category.toLowerCase(),
});

const pageUrl = 'https://oakfox.co.uk/blog';

const blogSchema = {
  '@type': 'Blog',
  '@id': `${pageUrl}#blog`,
  url: pageUrl,
  name: 'OakFox Journal',
  description:
    'Essays and practical guides on sustainable branding, accessible web design, green web development, marketing without greenwashing, and environmental consultancy, from OakFox, a sustainable design studio in West Lancashire, UK.',
  inLanguage: 'en-GB',
  publisher: { '@id': 'https://oakfox.co.uk/#organization' },
  blogPost: posts.slice(0, 10).map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    url: `https://oakfox.co.uk/blog/${post.id}`,
    author: { '@id': 'https://oakfox.co.uk/#organization' },
  })),
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Journal', item: pageUrl },
  ],
};
---

<BaseLayout
  title="Journal: Sustainable Branding, Web Design and Marketing"
  description="Essays and practical guides from the OakFox studio on sustainable branding, accessible web design, green web development, honest marketing and environmental consultancy."
  schema={[blogSchema, breadcrumbs]}
>
  <PageHero
    title="Journal"
    intro="Essays and practical guides from the studio on sustainable branding, accessible web design, green web development, honest marketing and environmental consultancy."
    primary={null}
    secondary={null}
  >
    <div class="mt-10 flex flex-col gap-5">
      <div class="relative max-w-md">
        <input
          id="blog-search"
          type="search"
          placeholder="Search the journal"
          class="w-full pl-12 pr-5 py-3.5 rounded-full border border-ink/15 bg-white text-[15px] text-ink placeholder:text-ink/50 focus:outline-none focus:border-forest focus:ring-2 focus:ring-forest/15 transition-all"
          aria-label="Search the journal"
        />
        <svg class="absolute left-5 top-1/2 -translate-y-1/2 w-4 h-4 text-ink/55" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
        </svg>
      </div>
      {topTags.length > 0 && (
        <ul class="flex flex-wrap gap-2" aria-label="Topics">
          {topTags.map(([tag, count]) => (
            <li>
              <a
                href={`/blog/tags/${tag}/`}
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full border border-stone bg-cream-light text-[14px] text-ink/80 hover:border-forest hover:text-forest transition-colors"
              >
                {tag} <span class="text-ink/45 figures">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </PageHero>

  <section class="pb-16 md:pb-24">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      {lead ? (
        <>
          <a
            href={`/blog/${lead.id}/`}
            class="blog-card group grid lg:grid-cols-12 gap-6 lg:gap-12 rounded-2xl bg-forest text-cream p-8 md:p-12 lg:p-14"
            {...searchData(lead)}
          >
            <div class="lg:col-span-8">
              <p class="text-[14px] text-cream/65">Latest, {date(lead.data.date)}</p>
              <h2 class="mt-4 text-3xl md:text-5xl font-semibold tracking-tight leading-[1.08] text-cream">{lead.data.title}</h2>
            </div>
            <div class="lg:col-span-4 flex flex-col justify-end">
              <p class="text-lg text-cream/80 leading-relaxed">{lead.data.description}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-[15px] font-medium text-leaf">
                Read it
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </div>
          </a>

          <ul class="mt-12 md:mt-16 border-t border-stone" id="blog-grid">
            {rest.map((post) => (
              <li class="border-b border-stone">
                <a
                  href={`/blog/${post.id}/`}
                  class="blog-card post-row group grid md:grid-cols-12 gap-2 md:gap-8 py-6 md:py-8 items-baseline"
                  {...searchData(post)}
                >
                  <span class="md:col-span-2 text-[15px] text-ink/60">
                    <time class="figures" datetime={post.data.date.toISOString()}>{date(post.data.date)}</time>
                  </span>
                  <span class="md:col-span-6">
                    <span class="block text-xl md:text-2xl font-semibold tracking-tight text-ink group-hover:text-forest transition-colors">{post.data.title}</span>
                    <span class="mt-1 block text-[14px] text-ink/55">{post.data.category}</span>
                  </span>
                  <span class="md:col-span-4 flex items-baseline justify-between gap-6 text-[15px] text-ink/65 leading-relaxed">
                    <span class="line-clamp-2">{post.data.description}</span>
                    <svg class="post-arrow w-5 h-5 shrink-0 text-forest" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <p class="text-ink/65 py-12">The first posts are on the way.</p>
      )}
      <p id="blog-empty" class="hidden text-lg text-ink/65 py-12">Nothing in the journal matches that search.</p>
    </div>
  </section>

  <section class="pb-20 md:pb-28">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <NewsletterSignup />
    </div>
  </section>
</BaseLayout>

<style>
  .post-arrow { opacity: 0; transform: translateX(-6px); transition: opacity 0.3s, transform 0.3s; }
  .post-row:hover .post-arrow { opacity: 1; transform: none; }
</style>

<script>
  function initBlogSearch() {
    const input = document.getElementById('blog-search') as HTMLInputElement | null;
    if (!input) return;
    const cards = document.querySelectorAll<HTMLAnchorElement>('.blog-card');
    const empty = document.getElementById('blog-empty');

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const hay = [
          card.dataset.title ?? '',
          card.dataset.description ?? '',
          card.dataset.tags ?? '',
          card.dataset.category ?? '',
        ].join(' ');
        const match = q === '' || hay.includes(q);
        // Rows hide their list item so the dividers go with them.
        const target = (card.closest('li') as HTMLElement | null) ?? card;
        target.style.display = match ? '' : 'none';
        if (match) visible += 1;
      });
      if (empty) empty.classList.toggle('hidden', visible > 0);
    });
  }

  document.addEventListener('astro:page-load', initBlogSearch);
</script>
