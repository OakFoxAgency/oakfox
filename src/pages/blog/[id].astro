---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuditCta from '../../components/AuditCta.astro';
import FaqList from '../../components/FaqList.astro';
import JournalLinks from '../../components/JournalLinks.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { getCollection, render } from 'astro:content';
import { isPublished } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', isPublished);
  return posts.map((post) => {
    const related = posts
      .filter((p) => p.id !== post.id)
      .map((p) => ({
        post: p,
        score: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
      }))
      .filter((r) => r.score > 0)
      .sort((a, b) => b.score - a.score || b.post.data.date.valueOf() - a.post.data.date.valueOf())
      .slice(0, 3)
      .map((r) => r.post);
    return {
      params: { id: post.id },
      props: { post, related },
    };
  });
}

const { post, related } = Astro.props;
const { Content, headings } = await render(post);
// The contents list: the article's own H2s, when there are enough to need one.
const contents = headings.filter((h) => h.depth === 2);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const relatedLinks = related.map((r) => ({ href: `/blog/${r.id}/`, title: r.data.title, note: r.data.description }));

const articleUrl = `https://oakfox.co.uk/blog/${post.id}`;
const articleSchema = {
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  inLanguage: 'en-GB',
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  articleSection: post.data.category,
  keywords: post.data.tags.join(', '),
  author: { '@id': 'https://oakfox.co.uk/#organization' },
  publisher: { '@id': 'https://oakfox.co.uk/#organization' },
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Journal', item: 'https://oakfox.co.uk/blog' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: articleUrl },
  ],
};

const pageSchemas: Record<string, unknown>[] = [articleSchema, breadcrumbs];
if (post.data.faq && post.data.faq.length > 0) {
  pageSchemas.push({
    '@type': 'FAQPage',
    '@id': `${articleUrl}#faq`,
    mainEntity: post.data.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
if (post.data.dataset) {
  const d = post.data.dataset;
  pageSchemas.push({
    '@type': 'Dataset',
    '@id': `${articleUrl}#dataset`,
    name: d.name,
    description: d.description,
    url: articleUrl,
    license: d.license,
    isAccessibleForFree: true,
    creator: { '@id': 'https://oakfox.co.uk/#organization' },
    datePublished: post.data.date.toISOString(),
    temporalCoverage: d.temporalCoverage,
    ...(d.spatialCoverage ? { spatialCoverage: d.spatialCoverage } : {}),
    keywords: d.keywords.join(', '),
    distribution: d.distribution.map((dist) => ({
      '@type': 'DataDownload',
      contentUrl: dist.contentUrl,
      encodingFormat: dist.encodingFormat,
    })),
  });
}
if (post.data.howto) {
  pageSchemas.push({
    '@type': 'HowTo',
    '@id': `${articleUrl}#howto`,
    name: post.data.howto.name,
    description: post.data.howto.description,
    ...(post.data.howto.totalTime ? { totalTime: post.data.howto.totalTime } : {}),
    step: post.data.howto.steps.map((s, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: s.name,
      text: s.text,
    })),
  });
}
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  schema={pageSchemas}
>
  <article>
    <header data-scene="hero" class="max-w-[1400px] mx-auto px-6 md:px-10 pt-28 md:pt-36 pb-10 md:pb-14">
      <a href="/blog/" class="inline-flex items-center gap-2 mb-6 text-[14px] font-medium text-ink/65 hover:text-forest transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Journal
      </a>
      <h1 class="headline article-title text-ink max-w-[22ch]">
        {post.data.title.split(' ').map((w, i, a) => (
          <><span class="split-word"><span>{w}</span></span>{i < a.length - 1 && ' '}</>
        ))}
      </h1>
      <div class="mt-8 grid lg:grid-cols-12 gap-y-6 lg:gap-x-16 items-start">
        <p data-hero-paragraph class="lg:col-span-7 text-xl md:text-2xl text-ink/70 leading-relaxed">{post.data.description}</p>
        <dl class="lg:col-span-5 grid grid-cols-2 gap-x-8 gap-y-4 text-[15px]">
          <div>
            <dt class="text-[13px] text-ink/65">Published</dt>
            <dd class="mt-0.5 font-medium text-ink"><time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time></dd>
          </div>
          {post.data.updated ? (
            <div>
              <dt class="text-[13px] text-ink/65">Updated</dt>
              <dd class="mt-0.5 font-medium text-ink"><time datetime={post.data.updated.toISOString()}>{fmt(post.data.updated)}</time></dd>
            </div>
          ) : (
            <div>
              <dt class="text-[13px] text-ink/65">Topic</dt>
              <dd class="mt-0.5 font-medium text-ink">{post.data.category}</dd>
            </div>
          )}
          <div>
            <dt class="text-[13px] text-ink/65">Written by</dt>
            <dd class="mt-0.5 font-medium text-ink"><a href="/about/" class="hover:text-forest underline decoration-ink/20 underline-offset-4">{post.data.author}</a></dd>
          </div>
          {post.data.tags.length > 0 && (
            <div class="col-span-2">
              <dt class="sr-only">Tags</dt>
              <dd class="flex flex-wrap gap-1.5">
                {post.data.tags.map((tag: string) => (
                  <a href={`/blog/tags/${tag}/`} class="px-3 py-1 rounded-full border border-stone bg-cream-light text-[13px] text-ink/75 hover:border-forest hover:text-forest transition-colors">{tag}</a>
                ))}
              </dd>
            </div>
          )}
        </dl>
      </div>
    </header>

    <div class="max-w-[1400px] mx-auto px-6 md:px-10 pb-16 md:pb-24">
    <div class="border-t border-stone pt-12 md:pt-16 grid lg:grid-cols-12 gap-12 lg:gap-16">
      {contents.length >= 3 && (
        <nav class="hidden lg:block lg:col-span-3" aria-label="In this article">
          <div class="sticky top-28">
            <p class="text-[14px] font-semibold text-ink">In this article</p>
            <ol class="mt-4 space-y-2.5 border-l border-stone">
              {contents.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="block -ml-px border-l border-transparent pl-4 text-[14px] leading-snug text-ink/65 hover:text-forest hover:border-forest transition-colors">{h.text}</a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      )}
      <div class={`min-w-0 ${contents.length >= 3 ? 'lg:col-span-8 lg:col-start-5' : 'lg:col-span-8 lg:col-start-3'}`}>
        <div class="prose-oak prose prose-lg max-w-[68ch]">
          <Content />
        </div>
      </div>
    </div>
    </div>
  </article>

  {post.data.faq && post.data.faq.length > 0 && (
    <FaqList title="Common questions" items={post.data.faq} />
  )}

  <AuditCta />

  {relatedLinks.length > 0 && (
    <JournalLinks
      title="Related reading"
      intro="More from the journal on the same subjects."
      posts={relatedLinks}
    />
  )}

  <section class="pb-16 md:pb-24 pt-4">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <NewsletterSignup />
    </div>
  </section>

  <CtaBlock
    title="Working on something similar?"
    text="We work with independent businesses and established brands across the UK, Ireland and Europe, on branding, web, marketing and environmental consultancy. Send a few lines and we'll reply within 24 hours."
  />
</BaseLayout>

<style>
  .article-title {
    font-size: clamp(2.4rem, 5vw, 4.75rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.03;
  }

  /* MDX content in the new type: a larger body, firm headings, tables and
     quotes that belong to the site rather than to the typography plugin. */
  .prose-oak {
    --tw-prose-body: color-mix(in oklab, var(--color-ink) 82%, transparent);
    --tw-prose-headings: var(--color-ink);
    --tw-prose-links: var(--color-forest);
    --tw-prose-bold: var(--color-ink);
    --tw-prose-bullets: var(--color-forest);
    --tw-prose-counters: var(--color-forest);
    --tw-prose-quotes: var(--color-ink);
    --tw-prose-quote-borders: var(--color-forest);
    --tw-prose-hr: var(--color-stone);
    --tw-prose-th-borders: var(--color-stone);
    --tw-prose-td-borders: var(--color-stone);
    font-size: 1.1875rem;
    line-height: 1.7;
  }
  .prose-oak :global(h2) { font-size: 2rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; margin-top: 2.4em; scroll-margin-top: 7rem; }
  .prose-oak :global(h3) { font-size: 1.4rem; font-weight: 600; letter-spacing: -0.015em; scroll-margin-top: 7rem; }
  .prose-oak :global(h4) { font-weight: 600; }
  .prose-oak :global(a) { text-underline-offset: 4px; text-decoration-thickness: 1px; overflow-wrap: anywhere; }
  .prose-oak :global(a:hover) { color: var(--color-forest-dark); }
  .prose-oak :global(blockquote) {
    font-style: normal;
    font-weight: 500;
    font-size: 1.3em;
    line-height: 1.45;
    padding-left: 1.25em;
  }
  .prose-oak :global(blockquote p::before),
  .prose-oak :global(blockquote p::after) { content: none; }
  .prose-oak :global(img) { border-radius: 1rem; }
  .prose-oak :global(table) { font-size: 0.875em; display: block; max-width: 100%; overflow-x: auto; }
  .prose-oak :global(thead th) { font-weight: 600; }
  .prose-oak :global(code) { font-weight: 500; }
</style>

<script>
  // Tables scroll sideways on narrow screens, so keyboard users must be able to focus them.
  document.querySelectorAll<HTMLElement>('.prose-oak table').forEach((t) => {
    if (t.scrollWidth > t.clientWidth) {
      t.tabIndex = 0;
      t.setAttribute('role', 'region');
      t.setAttribute('aria-label', 'Table (scrolls sideways)');
    }
  });
</script>
