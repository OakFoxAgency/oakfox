---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaBlock from '../../../components/CtaBlock.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', isPublished);
  const tagMap = new Map<string, typeof posts>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const arr = tagMap.get(tag) ?? [];
      arr.push(post);
      tagMap.set(tag, arr);
    }
  }
  return Array.from(tagMap.entries()).map(([tag, entries]) => ({
    params: { tag },
    props: {
      tag,
      posts: entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
const pageUrl = `https://oakfox.co.uk/blog/tags/${tag}`;
const displayTag = tag.charAt(0).toUpperCase() + tag.slice(1).replace(/-/g, ' ');
const count = `${posts.length} post${posts.length === 1 ? '' : 's'}`;
const date = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const collectionSchema = {
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: `OakFox Journal: ${displayTag}`,
  description: `Articles from the OakFox journal tagged "${displayTag}": ${posts.length} post${posts.length === 1 ? '' : 's'}.`,
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://oakfox.co.uk/#website' },
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Journal', item: 'https://oakfox.co.uk/blog' },
    { '@type': 'ListItem', position: 3, name: `Tag: ${displayTag}`, item: pageUrl },
  ],
};
---

<BaseLayout
  title={`${displayTag}: OakFox Journal`}
  description={`Articles from the OakFox journal tagged "${displayTag}". ${count} on sustainable design, development, marketing and environmental practice.`}
  schema={[collectionSchema, breadcrumbs]}
  noIndex
>
  <PageHero
    back={{ label: 'All posts', href: '/blog/' }}
    title={displayTag}
    intro={`${count} from the journal tagged "${displayTag}".`}
    primary={null}
    secondary={null}
  />

  <section class="pb-20 md:pb-28">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <ul class="border-t border-stone">
        {posts.map((post) => (
          <li class="border-b border-stone">
            <a href={`/blog/${post.id}/`} class="post-row group grid md:grid-cols-12 gap-2 md:gap-8 py-6 md:py-8 items-baseline">
              <time class="md:col-span-2 text-[15px] text-ink/65 figures" datetime={post.data.date.toISOString()}>{date(post.data.date)}</time>
              <span class="md:col-span-6">
                <span class="block text-xl md:text-2xl font-semibold tracking-tight text-ink group-hover:text-forest transition-colors">{post.data.title}</span>
                <span class="mt-1 block text-[14px] text-ink/65">{post.data.category}</span>
              </span>
              <span class="md:col-span-4 flex items-baseline justify-between gap-6 text-[15px] text-ink/65 leading-relaxed">
                <span class="line-clamp-2">{post.data.description}</span>
                <svg class="post-arrow w-5 h-5 shrink-0 text-forest" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBlock />
</BaseLayout>

<style>
  .post-arrow { opacity: 0; transform: translateX(-6px); transition: opacity 0.3s, transform 0.3s; }
  .post-row:hover .post-arrow { opacity: 1; transform: none; }
</style>
