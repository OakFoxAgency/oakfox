---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { locations as locationData } from '../../data/locations';

const pageUrl = 'https://oakfox.co.uk/locations';

const webPage = {
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: 'Locations: where OakFox works in the UK',
  description:
    'OakFox works with businesses across the UK: locally in West Lancashire (Ormskirk, Burscough, Southport), regionally across Manchester, Preston and Liverpool, and remotely across the UK, Ireland and Europe.',
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://oakfox.co.uk/#website' },
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: pageUrl },
  ],
};

const blurbs: Record<string, string> = {
  ormskirk: 'Our closest town, ten minutes from the studio. Independent retailers, hospitality and professional services along Burscough Street.',
  burscough: 'Home to the studio at Martland Mill. Independent food producers, maker studios and village hospitality.',
  southport: 'The closest coastal town. Hospitality, retail, cultural institutions and a growing independent scene.',
  preston: "Lancashire's administrative city. Professional services, universities and creative businesses.",
  manchester: 'Creative industries, independent hospitality, B2B software and cultural organisations.',
  lancashire: 'The county we call home. From the Ribble Valley to the West Coast, we work with businesses across Lancashire.',
};

const locations = locationData.map((l) => ({ ...l, blurb: blurbs[l.slug] ?? '' }));

// Drive times from the studio, read from the location data ("25 minutes west of the studio").
const drives = locationData
  .map((l) => ({ name: l.name, slug: l.slug, minutes: Number(l.distance.match(/^(\d+) minutes/)?.[1] ?? NaN), distance: l.distance }))
  .filter((d) => d.slug !== 'burscough' && Number.isFinite(d.minutes))
  .sort((a, b) => a.minutes - b.minutes);
const maxMinutes = Math.max(...drives.map((d) => d.minutes));
---

<BaseLayout
  title="Locations: Where We Work in the UK"
  description="OakFox works with businesses across the UK: locally in West Lancashire (Ormskirk, Burscough, Southport), regionally across Manchester, Preston and Lancashire, and remotely across the UK, Ireland and Europe."
  schema={[webPage, breadcrumbs]}
>
  <PageHero
    title="Based in West Lancashire, working across the UK."
    accent="Lancashire"
    intro="The studio is at Martland Mill in Burscough, between Ormskirk and Southport. Most of our work happens remotely, with visits in person for brand discovery, photography, installations and launches. These are the places we know best."
  >
    <div slot="aside" class="rounded-2xl bg-ink text-cream p-7 md:p-9">
      <p class="text-[15px] font-semibold">Drive time from the studio</p>
      <p class="mt-1 text-[14px] text-cream/80">Martland Mill, Burscough</p>
      <ul data-demo class="drives mt-7 space-y-5">
        {drives.map((d, i) => (
          <li>
            <a href={`/locations/${d.slug}/`} class="group block">
              <span class="flex items-baseline justify-between text-[15px]">
                <span class="font-medium group-hover:text-leaf transition-colors">{d.name}</span>
                <span class="figures text-cream/80">{d.minutes} min</span>
              </span>
              <span class="mt-2 block h-2 rounded-full bg-cream/10 overflow-hidden">
                <span class="drive-bar block h-full rounded-full bg-leaf" style={`--w: ${Math.round((d.minutes / maxMinutes) * 100)}%; --i: ${i}`}></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </PageHero>

  <section class="py-16 md:py-24 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <h2 class="headline text-4xl md:text-5xl">Where we work</h2>
      <div class="mt-10 md:mt-12 grid md:grid-cols-2 lg:grid-cols-12 gap-4 md:gap-5">
        {locations.map((l) => {
          const home = l.slug === 'burscough';
          const county = l.slug === 'lancashire';
          const span = home ? 'lg:col-span-7' : county ? 'lg:col-span-12' : l.slug === 'ormskirk' ? 'lg:col-span-5' : 'lg:col-span-4';
          const tone = home ? 'bg-forest text-cream' : county ? 'bg-moss' : 'bg-cream-light border border-stone';
          return (
            <a href={`/locations/${l.slug}/`} class={`reveal group flex flex-col rounded-2xl p-7 md:p-9 min-h-[15rem] transition-transform duration-300 hover:-translate-y-0.5 ${span} ${tone}`}>
              <span class={`text-[13px] ${home ? 'text-cream/80' : 'text-ink/65'}`}>{l.region.replace(' / ', ' and ')}</span>
              <h3 class="mt-2 text-3xl md:text-4xl font-semibold tracking-tight">{l.name}</h3>
              <p class={`mt-3 text-base leading-relaxed max-w-[52ch] ${home ? 'text-cream/80' : 'text-ink/70'}`}>{l.blurb}</p>
              <span class={`mt-auto pt-6 inline-flex items-center gap-2 text-[15px] font-medium ${home ? 'text-leaf' : 'text-forest'}`}>
                Services in {l.name}
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <CtaBlock
    title="Somewhere else? We work UK-wide."
    text="Clients in the Lake District, Dublin, Edinburgh, London and Cornwall have all worked with us remotely. Send a few lines about your project: location is rarely the constraint."
    showLocations={false}
  />
</BaseLayout>

<style>
  .drive-bar {
    width: 0;
    transition: width 1.2s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(0.2s + var(--i) * 0.12s);
  }
  .drives:global(.is-in) .drive-bar { width: var(--w); }
  @media (prefers-reduced-motion: reduce) {
    .drive-bar { width: var(--w); transition: none; }
  }
</style>
