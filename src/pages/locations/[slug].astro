---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import JournalLinks from '../../components/JournalLinks.astro';
import AuditCta from '../../components/AuditCta.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import { locations, type Location } from '../../data/locations';

export async function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const pageUrl = `https://oakfox.co.uk/locations/${location.slug}`;
const isBase = location.slug === 'burscough';
const isCounty = location.slug === 'lancashire';

// The description's first sentence leads the hero; the rest opens the local section.
const description = location.description;
const splitAt = description.search(/\.\s/);
const lead = splitAt > 0 ? description.slice(0, splitAt + 1) : description;
const rest = splitAt > 0 ? description.slice(splitAt + 2) : '';

const distanceLabel = isBase ? 'Home of the studio' : isCounty ? 'Our home county' : location.distance.replace(/ of the studio$/, '');
const distanceCaption = isBase ? 'Martland Mill, Mart Lane, Burscough' : isCounty ? 'From the Ribble Valley to the West Lancashire coast' : 'from the studio at Martland Mill, Burscough';
const place = location.region.replace(' / ', ' and the ');

const services = [
  { label: 'Branding', href: '/services/branding/' },
  { label: 'Web design', href: '/services/web-design/' },
  { label: 'Web development', href: '/services/development/' },
  { label: 'Marketing', href: '/services/marketing/' },
  { label: 'Copywriting', href: '/services/copywriting/' },
  { label: 'Green web hosting', href: '/services/green-web-hosting/' },
];

const webPage = {
  '@type': 'WebPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: `Design studio serving ${location.name}, OakFox`,
  description: `Branding, web design, development, marketing, copywriting and green web hosting for businesses in ${location.name}, ${location.region}.`,
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://oakfox.co.uk/#website' },
  about: { '@id': 'https://oakfox.co.uk/#organization' },
};

const placeSchema = {
  '@type': 'Place',
  '@id': `${pageUrl}#place`,
  name: location.name,
  address: {
    '@type': 'PostalAddress',
    addressLocality: location.name,
    addressRegion: location.region,
    postalCode: location.postcode,
    addressCountry: 'GB',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: location.geo.lat,
    longitude: location.geo.lng,
  },
};

const serviceArea = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: `OakFox design, development and marketing services in ${location.name}`,
  provider: { '@id': 'https://oakfox.co.uk/#organization' },
  serviceType: 'Branding, web design, web development, marketing, copywriting, and green web hosting',
  areaServed: { '@id': `${pageUrl}#place` },
  description: `OakFox provides sustainable branding, web design, development, marketing, copywriting and green web hosting for businesses in ${location.name} and the surrounding ${location.region} area.`,
  url: pageUrl,
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: 'https://oakfox.co.uk/locations' },
    { '@type': 'ListItem', position: 3, name: location.name, item: pageUrl },
  ],
};

const faqs = [
  {
    q: `Do you work with businesses in ${location.name}?`,
    a: isBase
      ? `Yes. ${location.name} is where the studio is, and we work with clients here on brand identity, website design, development, marketing, copywriting and green web hosting.`
      : `Yes. ${location.name} is ${location.distance.toLowerCase()}, and we work with clients there on brand identity, website design, development, marketing, copywriting and green web hosting.`,
  },
  {
    q: `How does working with a ${location.name} design studio compare to a London or Manchester agency?`,
    a: `You get the principal on the work, not an account manager passing briefs to a pool of juniors. Costs are typically 30 to 50% lower than equivalent London agencies for the same quality, turnaround is faster because decisions don't pass through several layers, and the person who quoted you is the person you work with from start to finish.`,
  },
  {
    q: `Can we meet in person in ${location.name}?`,
    a: `Yes. ${isBase ? 'We are based in Burscough itself, so studio visits take minutes.' : `${location.name} is ${location.distance.toLowerCase()}. We visit in person for brand discovery workshops, photography and shoots, milestone reviews and launches.`} Day-to-day delivery happens remotely, so timelines aren't held up by travel.`,
  },
  {
    q: `Which sectors do you know best in ${location.name}?`,
    a: `We have worked most with ${location.sectors.slice(0, 3).join(', ').toLowerCase()} in and around ${location.name}. The principles of considered branding, accessible web design and honest marketing travel well across sectors, though.`,
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const relatedWork = (location.relatedWork ?? []).map((w) => ({
  href: `/portfolio/${w.slug}/`,
  title: w.title,
  note: w.note,
}));
---

<BaseLayout
  title={`Web Design in ${location.name}: Independent Studio`}
  description={`Website design, branding and development for ${location.name} businesses from an independent studio in Burscough${isBase || isCounty ? '' : `, ${location.distance.toLowerCase()}`}. You work with the designer, not an account manager.`}
  schema={[webPage, placeSchema, serviceArea, breadcrumbs, faqSchema]}
>
  <PageHero
    back={{ label: 'All locations', href: '/locations/' }}
    title={`Web design and branding for ${location.name} businesses.`}
    accent={location.name}
    place={place}
    intro={lead}
  >
    <!-- Real data only: drive time, region, postcode area and nearby towns. -->
    <div slot="aside" class="rounded-2xl bg-ink text-cream p-7 md:p-9">
      <p class="text-[13px] text-cream/60">{isBase || isCounty ? 'Where we are' : 'Drive time'}</p>
      <p class="mt-2 text-4xl md:text-5xl font-semibold tracking-tight leading-[1.05]">{distanceLabel}</p>
      <p class="mt-2 text-[15px] text-cream/70">{distanceCaption}</p>
      <dl class="mt-8 pt-6 border-t border-cream/10 grid grid-cols-2 gap-6">
        <div>
          <dt class="text-[13px] text-cream/55">Region</dt>
          <dd class="mt-1 text-[15px]">{location.region.replace(' / ', ' and ')}</dd>
        </div>
        <div>
          <dt class="text-[13px] text-cream/55">Postcode area</dt>
          <dd class="mt-1 text-[15px] figures">{location.postcode}</dd>
        </div>
      </dl>
      <p class="mt-6 text-[13px] text-cream/55">Nearby</p>
      <ul class="mt-2 flex flex-wrap gap-2">
        {location.nearby.map((n) => (
          <li class="rounded-full border border-cream/20 px-3.5 py-1.5 text-[14px] text-cream/85">{n}</li>
        ))}
      </ul>
    </div>
  </PageHero>

  <!-- Local knowledge: the rest of the description, then the checkable notes. -->
  {(rest || location.localNotes) && (
    <section class="py-16 md:py-24 border-t border-stone">
      <div class="max-w-[1400px] mx-auto px-6 md:px-10 grid lg:grid-cols-12 gap-10 lg:gap-16">
        <div class="lg:col-span-5">
          <h2 class="headline text-4xl md:text-5xl">{isCounty ? 'Across the county' : `Getting to know ${location.name}`}</h2>
          {rest && <p class="mt-6 text-lg text-ink/75 leading-relaxed max-w-[52ch]">{rest}</p>}
        </div>
        {location.localNotes && (
          <div class="lg:col-span-7 rounded-2xl bg-moss p-7 md:p-10">
            <p class="text-[15px] font-semibold text-ink">Local detail</p>
            <ul class="mt-4 divide-y divide-ink/10">
              {location.localNotes.map((n) => (
                <li class="py-4 first:pt-2 last:pb-0 text-base md:text-[17px] text-ink/80 leading-relaxed">{n}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Services, linked with local anchor text. -->
  <section class="py-16 md:py-24 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <h2 class="headline text-4xl md:text-5xl max-w-[22ch]">What we offer in {location.name}</h2>
      <p class="mt-5 text-lg text-ink/70 leading-relaxed max-w-[56ch]">
        The full OakFox offer is available to {location.name} clients, often combined in a single project for a more joined-up result.
      </p>
      <ul class="mt-10 md:mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5">
        {services.map((s) => (
          <li class="reveal">
            <a href={s.href} class="group flex items-center justify-between gap-6 rounded-2xl border border-stone bg-cream-light px-6 py-6 md:px-7 hover:border-forest transition-colors">
              <span class="text-xl font-semibold tracking-tight text-ink group-hover:text-forest transition-colors">{s.label} in {location.name}</span>
              <svg class="w-5 h-5 shrink-0 text-forest transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- What we know about the place, and who we tend to work with there. -->
  <section class="py-16 md:py-24 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <div class="lg:col-span-7">
        <h2 class="headline text-4xl md:text-5xl">What we know about {location.name}</h2>
        <ul class="mt-10 space-y-6">
          {location.strengths.map((s) => (
            <li class="reveal flex gap-4 text-lg md:text-xl text-ink/85 leading-snug">
              <span class="mt-0.5 shrink-0 w-7 h-7 rounded-full bg-moss text-forest grid place-items-center" aria-hidden="true">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-2xl border border-stone bg-cream-light p-7 md:p-9">
          <h3 class="text-2xl font-semibold tracking-tight">Who we tend to work with</h3>
          <ul class="mt-6 flex flex-wrap gap-2.5">
            {location.sectors.map((s) => (
              <li class="rounded-full bg-moss px-4 py-2 text-[15px] text-ink">{s}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {relatedWork.length > 0 && (
    <JournalLinks
      title={`Work that fits ${location.name}`}
      intro={`Case studies from the sectors that lead ${location.name}'s independent scene: the closest match to the work we'd do here.`}
      posts={relatedWork}
    />
  )}

  <FaqList title={`Working with us in ${location.name}`} items={faqs}>
    Typical prices, from DIY builders to agencies:
    <a href="/blog/how-much-does-a-website-cost-uk/" class="text-forest underline underline-offset-4">how much a website costs in the UK</a>.
  </FaqList>

  <AuditCta />

  <CtaBlock
    title={`Start a project in ${location.name}.`}
    text="Send a few lines about your business and what you're trying to do. We reply within 24 hours, with no pitch deck and no obligation."
  />
</BaseLayout>
