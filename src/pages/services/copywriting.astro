---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Pillars from '../../components/Pillars.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import FitList from '../../components/FitList.astro';
import FaqList from '../../components/FaqList.astro';
import LocationSignpost from '../../components/LocationSignpost.astro';
import AuditCta from '../../components/AuditCta.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import StrikeEdit from '../../components/demo/StrikeEdit.astro';

const pageUrl = 'https://oakfox.co.uk/services/copywriting';

const serviceSchema = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: 'Copywriting',
  description: 'Copywriting for brands that value substance over slogans. Website copy, campaign copy, brand voice and editing: honest, precise, and written to convert without marketing speak.',
  provider: { '@id': 'https://oakfox.co.uk/#organization' },
  areaServed: ['United Kingdom', 'Ireland', 'Europe'],
  serviceType: 'Copywriting and content strategy',
  url: pageUrl,
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://oakfox.co.uk/services' },
    { '@type': 'ListItem', position: 3, name: 'Copywriting', item: pageUrl },
  ],
};

const offerings = [
  {
    title: 'Voice and tone guidelines',
    description:
      'How your brand should sound on the homepage, in a customer service reply or in a pitch deck. A practical voice guide your team can use, not a 30-page philosophy document.',
  },
  {
    title: 'Website copy that earns the scroll',
    description:
      'Homepages, service, about and product pages. Clear and specific, with the detail that makes a prospect trust you. SEO-aware without reading like it was written for a robot.',
  },
  {
    title: 'Campaign and editorial work',
    description:
      "Launch announcements, case studies, email sequences and long-form articles: written to a brief, edited until it's tight, and delivered in the format your team uses.",
  },
];

const process = [
  { title: 'Listen', body: "A conversation about what the business does, who it talks to and what's been written before. We read your existing copy, your reviews, and what customers have said to you in their own words." },
  { title: 'Scope', body: "A one-page brief covering pages, word counts, voice and deadlines, agreed before writing starts so nobody's guessing at the end." },
  { title: 'Draft', body: 'A first pass written to the brief: opinionated enough to react to, restrained enough to be a real draft rather than a showreel.' },
  { title: 'Refine', body: 'Two rounds of edits as standard. We push back where we disagree, and defer where the call is yours.' },
  { title: 'Hand over', body: "Copy delivered as a Google Doc, ready for your CMS, or straight into the page, plus voice notes if they'll help whoever writes next." },
];

const forWho = [
  'Founders tired of copy that sounds like everyone else in their sector',
  'Businesses rebranding who want the words to match the new look',
  'Sustainability-focused brands who need to make honest claims persuasively',
  'Teams launching a site, product or campaign against a deadline',
  "Anyone who's been quoted £50 per 500 words and noticed the quality",
];

const faqs = [
  {
    q: 'How much does website copywriting cost?',
    a: 'Copywriting projects at OakFox typically range from £900 for a single, carefully written landing page to £6,000 or more for a full website copy overhaul including voice guidelines. Every quote is priced on scope and expertise rather than word count, and we send a detailed proposal after a free first call.',
  },
  {
    q: 'Do you write SEO-optimised copy?',
    a: 'Yes, but we write for readers first and search engines second. Keyword research shapes the topic and structure, not the sentences. Pages rank because they answer a search better than the competition, not because the target phrase is in every paragraph. The copy we deliver reads naturally and ranks.',
  },
  {
    q: 'What is the difference between copywriting and content writing?',
    a: 'Copywriting is persuasive, commercial writing: homepages, service pages, email sequences and landing pages. Content writing is editorial or educational: articles, guides and long-form resources. We do both, but brief them differently. Copy earns a decision; content earns trust.',
  },
  {
    q: 'Will you use my existing brand voice or create one?',
    a: "Either. If you have a voice guide, we stress-test it and write to it. If you don't, we can develop one as the first part of the project: principles, tone rules, vocabulary lists, and examples of good and bad for your team to refer to. It takes a few hours and keeps paying off.",
  },
  {
    q: 'How do you handle sustainability claims and avoid greenwashing?',
    a: 'Every claim we write is one you could defend to a regulator. We ask for evidence, check supply chains where relevant, and won\'t write vague language like "eco-friendly" or "planet-positive" without substantiation. Clear claims and honest caveats make a stronger brand; greenwashing is a short-term gain and a long-term reputational risk.',
  },
  {
    q: 'How many rounds of revisions are included?',
    a: "Two rounds of edits are included as standard on all copywriting work, and most projects never need the second. Extra rounds are charged at a transparent hourly rate agreed in the proposal, but they're rarely needed.",
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Brand & Website Copywriter, UK"
  description="OakFox writes website copy, campaign copy, brand voice and long-form for brands that value substance over slogans. Honest, precise and SEO-aware, without the marketing speak or greenwashing."
  schema={[serviceSchema, breadcrumbs, faqSchema]}
>
  <PageHero
    back={{ label: 'Services', href: '/services/' }}
    title="Words that mean something, not words that fill space."
    accent="something"
    intro="Writing for brands with something specific to say. Website copy, campaign copy, brand voice and long-form, edited until it reads easily. No marketing speak, no filler, and no greenwashing in the sustainability work."
  >
    <div slot="aside" class="rounded-2xl bg-moss p-8 md:p-10">
      <StrikeEdit
        class="text-2xl md:text-[2rem]"
        before="Our passionate team delivers innovative, world-class solutions for your business journey."
        after="We write clear website copy for independent businesses."
      />
      <p class="mt-8 text-[15px] text-ink/65">Vague words out, specific ones in.</p>
    </div>
  </PageHero>

  <Pillars items={offerings} />

  <ProcessSteps title="How a copywriting project runs" steps={process} />

  <FitList title="A good fit if you're one of these" items={forWho} />

  <FaqList title="Copywriting questions we hear a lot" items={faqs}>
    Why vague green claims cost more than they win:
    <a href="/blog/sustainability-claims-without-greenwashing/" class="text-forest underline underline-offset-4">how to write sustainability claims that aren't greenwashing</a>.
  </FaqList>

  <LocationSignpost service="Copywriting" keyword="copywriting" />

  <AuditCta />

  <CtaBlock
    title="Send us what you have."
    text="A link to your current site, or a description of what you're launching. We reply within 24 hours with a short read on what we'd do with it."
  />
</BaseLayout>
