---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Pillars from '../../components/Pillars.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import FitList from '../../components/FitList.astro';
import FaqList from '../../components/FaqList.astro';
import LocationSignpost from '../../components/LocationSignpost.astro';
import AuditCta from '../../components/AuditCta.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Rotator from '../../components/demo/Rotator.astro';

const pageUrl = 'https://oakfox.co.uk/services/marketing';

const serviceSchema = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: 'Marketing',
  description: 'Marketing strategy and delivery for independent brands: content, email, organic social and SEO, built on substance, measured honestly, with no greenwashing.',
  provider: { '@id': 'https://oakfox.co.uk/#organization' },
  areaServed: ['United Kingdom', 'Ireland', 'Europe'],
  serviceType: 'Marketing strategy and content',
  url: pageUrl,
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://oakfox.co.uk/services' },
    { '@type': 'ListItem', position: 3, name: 'Marketing', item: pageUrl },
  ],
};

const offerings = [
  {
    title: 'A plan you can actually follow',
    description:
      "One clear strategy document: who you're for, where you'll meet them, what you'll say and how you'll measure it. Practical, and short enough to get read.",
  },
  {
    title: 'Content that earns attention',
    description:
      'Journal articles, newsletters and long-form, written with real expertise rather than as keyword bait. Fewer, better pieces that do the work of twenty thin ones.',
  },
  {
    title: 'Email, organic social and SEO',
    description:
      "Email campaigns that respect the inbox, organic social with a point of view, and SEO that means writing genuinely useful pages. Paid media only when it's the honest answer.",
  },
];

const process = [
  { title: 'Listen', body: "A conversation about the business, your existing customers, your goals for the next 6 to 12 months, and what marketing has done so far: what worked, what didn't and what never got tried." },
  { title: 'Audit', body: 'A focused look at your website, analytics, rankings, social and email list, to find where the leverage is rather than where the vanity metrics look good.' },
  { title: 'Strategy', body: 'A one-document plan covering audiences, channels, content pillars, an editorial calendar and KPIs, agreed with you before anything is built.' },
  { title: 'Build', body: 'Writing, designing and shipping: the content calendar filled, email sequences written, organic social moving and SEO improvements in place.' },
  { title: 'Review', body: "Monthly check-ins against the KPIs we agreed: an honest read on what's working, what to cut and what to do more of." },
];

const forWho = [
  "Independent businesses doing good work that isn't reaching the audience it deserves",
  'Brands launching or repositioning who need marketing to match',
  'Sustainability-focused businesses who want claims that hold up to scrutiny',
  "Founders who've tried agency retainers and ended up with generic content they never shipped",
  'Teams who value clarity and a steady cadence over volume',
];

const faqs = [
  {
    q: 'How much does a marketing retainer cost?',
    a: 'Marketing at OakFox typically runs from £1,500 a month for focused content and SEO to £6,000 or more a month for strategy, content, email and organic social together. One-off strategy projects start at £3,500. Every proposal is scoped to the hours and services you actually need rather than a fixed tier.',
  },
  {
    q: 'Do you run paid ads?',
    a: "Only when it's the honest answer. Paid media works for specific situations: product launches, seasonal campaigns, event promotion and geographic expansion. For most independent brands, organic content, SEO and email give better long-term returns per pound, and we'll tell you which applies to you before taking your budget.",
  },
  {
    q: 'Can you handle SEO for a new website?',
    a: 'Yes. SEO at OakFox means clear information architecture, substantial content that answers real searches, fast pages, proper structured data, and steady content that builds topical authority. No link schemes, no programmatic junk and no AI-generated filler. Results take three to nine months, and the compounding starts straight away.',
  },
  {
    q: 'Will my content be written by AI?',
    a: "No. We use AI for research, first drafts of internal documents and admin, but we won't ship it as client-facing work. Every published piece is written, edited and fact-checked by a person who understands your business.",
  },
  {
    q: 'How do you measure marketing success?',
    a: "Honestly. We agree the two or three metrics that matter for your business, such as qualified enquiries, direct traffic, rankings for target searches, email list growth or retention, and report against them monthly. No bloated dashboards or vanity metrics. If something isn't working, we cut it and say so.",
  },
  {
    q: 'What sectors do you work with?',
    a: "Independent hospitality, small consumer brands, professional services, cultural and charitable organisations, and B2B software, with a particular focus on sustainability-driven businesses. We turn down sectors we can't support in good faith, which usually means fossil fuels, fast fashion and anything that relies on manipulative advertising.",
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Sustainable Marketing Agency, UK"
  description="OakFox is a sustainable marketing agency in West Lancashire, UK. Strategy, content, email, organic social and SEO for independent brands, measured honestly, with no greenwashing and no vanity metrics."
  schema={[serviceSchema, breadcrumbs, faqSchema]}
>
  <PageHero
    back={{ label: 'Services', href: '/services/' }}
    title="Marketing that earns attention, rather than buying it."
    accent="earns"
    intro="Strategy, content and channel work for independent businesses. Fewer, better pieces, email that respects the inbox, organic social with a point of view, and SEO built on useful pages. Paid media only when it's the honest answer."
  >
    <div slot="aside" class="rounded-2xl border border-stone bg-cream-light p-8 md:p-10">
      <Rotator class="text-4xl md:text-5xl" />
      <p class="mt-8 text-[15px] text-ink/65">Strategy first, then the channels that suit you.</p>
    </div>
  </PageHero>

  <Pillars items={offerings} />

  <ProcessSteps title="How marketing with us runs" steps={process} />

  <FitList title="A good fit if you're one of these" items={forWho} />

  <FaqList title="Marketing questions we hear a lot" items={faqs}>
    What a realistic budget looks like:
    <a href="/blog/how-much-does-marketing-cost-small-business-uk/" class="text-forest underline underline-offset-4">how much marketing costs for a small business in the UK</a>.
  </FaqList>

  <LocationSignpost service="Marketing" keyword="sustainable marketing" />

  <AuditCta />

  <CtaBlock
    title="Tell us what you're trying to move."
    text="Send a few lines about the goal: more leads, a launch, better retention, or a rebrand that needs momentum. We reply within 24 hours with a first read."
  />
</BaseLayout>
