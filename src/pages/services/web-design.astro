---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Pillars from '../../components/Pillars.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import FitList from '../../components/FitList.astro';
import FaqList from '../../components/FaqList.astro';
import LocationSignpost from '../../components/LocationSignpost.astro';
import JournalLinks from '../../components/JournalLinks.astro';
import AuditCta from '../../components/AuditCta.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Reflow from '../../components/demo/Reflow.astro';

const journalPosts = [
  {
    href: '/blog/sustainable-web-design-practical-guide/',
    title: 'Sustainable web design: a practical guide',
    note: 'The techniques we use on every build: page-weight budgets, system fonts, efficient images, static-first architecture, and how to measure what a page costs in carbon.',
  },
  {
    href: '/blog/is-your-web-host-actually-green/',
    title: 'Is your web host actually green?',
    note: "How to check a host's renewable claims in about 30 seconds, and the difference between offsetting and genuinely green infrastructure.",
  },
];

const pageUrl = 'https://oakfox.co.uk/services/web-design';

const serviceSchema = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: 'Web Design',
  description: 'Website design for independent brands: information architecture, user experience, visual design and design systems, built around how your audience actually uses the site.',
  provider: { '@id': 'https://oakfox.co.uk/#organization' },
  areaServed: ['United Kingdom', 'Ireland', 'Europe'],
  serviceType: 'Website design',
  url: pageUrl,
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://oakfox.co.uk/services' },
    { '@type': 'ListItem', position: 3, name: 'Web Design', item: pageUrl },
  ],
};

const offerings = [
  {
    title: 'Structure before surface',
    description:
      "Sitemap, page templates and the decisions about what lives where. We do this first, because the best visual design won't save a site people can't find their way around.",
  },
  {
    title: 'Considered visual design',
    description:
      'Typography, layout, colour, imagery and motion, tuned to the brand and the content. Accessibility is built in from the start, not added after sign-off.',
  },
  {
    title: 'A design system that scales',
    description:
      'Components, patterns and tokens handed over as a working Figma file, so new pages are quicker to build and stay consistent as the site grows.',
  },
];

const process = [
  { title: 'Listen', body: "A proper conversation about what the site needs to do for the business, its visitors and the people who'll look after it." },
  { title: 'Architect', body: 'Sitemap, user journeys and page templates, agreed before anything is designed.' },
  { title: 'Design', body: 'One direction developed in detail, rather than three shallow options, with the reasoning behind each decision.' },
  { title: 'Refine', body: 'Two rounds of revisions, tested on real content, real screens and the accessibility standard you need to meet.' },
  { title: 'Hand over', body: "The design system, assets and a walk-through with your developers, or straight into our build if we're developing it too." },
];

const forWho = [
  'Independent businesses launching or rebuilding their site',
  "Brands whose website no longer matches how far they've come",
  'Founders who want accessible, low-carbon design rather than a reskinned template',
  'Teams buying design separately from development who need a clean handover',
];

const faqs = [
  {
    q: 'How much does a website design project cost?',
    a: 'Web design at OakFox typically ranges from £3,500 for a focused landing page to £15,000 or more for a full multi-page site with a design system, research and accessibility auditing. Every quote is worked out case by case, and we send a detailed written proposal after a free first call.',
  },
  {
    q: 'How long does it take to design a website?',
    a: 'A focused marketing site usually takes four to eight weeks from kick-off to design sign-off. A larger, content-led site with research, a design system and several rounds of stakeholder review runs ten to fourteen weeks. We agree the timeline while scoping and protect it with weekly milestone reviews.',
  },
  {
    q: 'What does "sustainable web design" actually mean?',
    a: "It means reducing the energy needed to serve and use a website: lighter pages, fewer requests, efficient images, minimal JavaScript, clean semantic markup, and hosting on verified renewable-powered infrastructure. It also means designing for longevity, so the site doesn't need rebuilding in two years because a framework fell out of fashion.",
  },
  {
    q: 'Do you design accessible websites?',
    a: 'Yes. Accessibility is part of the design from the start rather than retrofitted. We design to WCAG 2.2 AA as a minimum: colour contrast, focus states, semantic structure, keyboard navigation, screen reader labels and testing with real content. We check accessibility at every stage, not just at the end. For a site that already exists, we also offer accessibility audits and fixes, using our own checker, A11yMate.',
  },
  {
    q: 'Do you hand over a design system or just final files?',
    a: "A design system is the default: components, tokens, type scales, spacing rules and usage guidelines in a working Figma file, so future pages are quicker to build and stay consistent. Static PDFs are available if you need them, but they go out of date quickly and we don't recommend them.",
  },
  {
    q: 'Can OakFox build the website too, or do I need a separate developer?',
    a: 'Either works. Many clients take design and development together with us, which means fewer handoffs and faster delivery. If you already have a developer, we hand over a thorough package so they can build from the system with confidence. We also do design-only work for agencies.',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Web Design Studio: Accessible, Low-Carbon Websites"
  description="OakFox is a sustainable web design studio in West Lancashire, UK. Accessible website design, information architecture and design systems for independent brands, built to last rather than to follow trends."
  schema={[serviceSchema, breadcrumbs, faqSchema]}
>
  <PageHero
    back={{ label: 'Services', href: '/services/' }}
    title="Websites designed around the people who use them."
    accent="people"
    intro="Information architecture, user experience and visual design for businesses who know a good-looking homepage isn't enough. Accessible from the start, and handed over as a design system your developers (or ours) can build from."
  >
    <div slot="aside" class="rounded-2xl border border-stone bg-cream-light p-8 md:p-10">
      <Reflow />
      <p class="mt-8 text-[15px] text-ink/65 text-center">The same structure, reflowing from desktop to phone.</p>
    </div>
  </PageHero>

  <Pillars items={offerings} />

  <ProcessSteps title="How a web design project runs" steps={process} />

  <FitList title="A good fit if you're" items={forWho} />

  <FaqList title="Web design questions we hear a lot" items={faqs}>
    Typical prices, from DIY builders to agencies:
    <a href="/blog/how-much-does-a-website-cost-uk/" class="text-forest underline underline-offset-4">how much a website costs in the UK</a>.
    Already have a site? Our <a href="/services/accessibility/" class="text-forest underline underline-offset-4">accessibility audits and fixes</a> use <a href="https://a11ymate.co.uk" class="text-forest underline underline-offset-4">A11yMate</a>, our own checker.
  </FaqList>

  <LocationSignpost service="Web design" keyword="sustainable web design" />

  <JournalLinks
    intro="How we build fast, accessible, low-carbon sites: the practical detail behind the service."
    posts={journalPosts}
  />

  <AuditCta />

  <CtaBlock
    title="Tell us about the site, and the goal."
    text="Send the current URL if there is one, and a line or two about what you want the site to do. We reply within 24 hours with a first read."
  />
</BaseLayout>
