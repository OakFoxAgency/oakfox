---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Pillars from '../../components/Pillars.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import FitList from '../../components/FitList.astro';
import FaqList from '../../components/FaqList.astro';
import LocationSignpost from '../../components/LocationSignpost.astro';
import JournalLinks from '../../components/JournalLinks.astro';
import AuditCta from '../../components/AuditCta.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Specimen from '../../components/demo/Specimen.astro';

const journalPosts = [
  {
    href: '/blog/choosing-a-brand-name/',
    title: 'Choosing a brand name: the process behind the shortlist',
    note: 'How we take a business from a blank page to a defensible name: research, candidate names, availability checks, and a shortlist with reasoning.',
  },
  {
    href: '/blog/how-to-brief-a-branding-agency/',
    title: 'How to brief a branding agency',
    note: 'What a useful brief contains, what to leave out, and the questions a good agency should ask you back. Worth reading before you approach anyone, including us.',
  },
  {
    href: '/blog/what-makes-a-brand-sustainable/',
    title: 'What makes a brand sustainable?',
    note: 'Beyond the green logo: the operational, supply chain and messaging decisions that separate a genuinely sustainable brand from a greenwashed one.',
  },
];

const pageUrl = 'https://oakfox.co.uk/services/branding';

const serviceSchema = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: 'Sustainable Brand Identity',
  description: 'Brand identity systems for businesses that want to grow without the environmental cost. Naming, visual language, typography, messaging and guidelines, built to last.',
  provider: { '@id': 'https://oakfox.co.uk/#organization' },
  areaServed: ['United Kingdom', 'Ireland', 'Europe'],
  serviceType: 'Brand identity design',
  url: pageUrl,
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://oakfox.co.uk/services' },
    { '@type': 'ListItem', position: 3, name: 'Branding', item: pageUrl },
  ],
};

const offerings = [
  {
    title: 'Logo, wordmark and visual system',
    description:
      'Marks that work at every size and on every surface, from a shop sign to a 12×12mm favicon. Built with restraint so they outlast trends.',
  },
  {
    title: 'Naming, messaging and tone of voice',
    description:
      'How your brand sounds across your site, packaging and social: clear, confident and honest about what you do.',
  },
  {
    title: 'Brand guidelines and asset library',
    description:
      'Everything your team and future suppliers need to keep the brand consistent, delivered as a living document rather than a 40-page PDF nobody reads.',
  },
];

const process = [
  { title: 'Listen', body: 'A proper conversation about what your business actually does, who it serves and what makes it worth keeping around.' },
  { title: 'Audit', body: 'Where you are now: your existing brand, your competitors, and how your audience sees you today.' },
  { title: 'Direction', body: 'One or two focused directions with the reasoning behind them, not ten options that leave you to choose for us.' },
  { title: 'Build', body: 'The identity system, typography, photography direction, guidelines and all the moving parts.' },
  { title: 'Hand over', body: 'Guidelines, working files and a walk-through, so you can use the brand confidently from day one.' },
];

const forWho = [
  'An independent business launching or relaunching with sustainability at its core',
  "An established brand whose identity no longer reflects how far you've come",
  'A founder who wants considered creative direction, not a deck of stock mood boards',
];

const faqs = [
  {
    q: 'How much does a brand identity cost?',
    a: 'Brand identity projects at OakFox typically range from £4,500 for a focused visual refresh to £18,000 or more for a full identity system with naming, messaging, guidelines and launch assets. Every quote is shaped around the project rather than a fixed tier, and we send a detailed written proposal after a free first call.',
  },
  {
    q: 'How long does a branding project take?',
    a: 'A focused brand refresh usually takes four to six weeks. A full identity system, with naming, visual language, messaging, guidelines and launch assets, usually runs eight to twelve weeks from kick-off to handover. We agree the timeline while scoping and protect it with weekly milestone reviews.',
  },
  {
    q: 'What makes OakFox a sustainable branding agency?',
    a: "Sustainability runs through every decision. We only work with collaborators we can verify, recommend print partners on renewable-powered presses, deliver digital assets in formats that are efficient to serve, and challenge clients when they propose greenwashing. We also turn down projects we can't support in good faith.",
  },
  {
    q: 'Do you offer naming as part of a brand identity project?',
    a: 'Yes. Naming is a scoped module in any full identity project, and can also be a project on its own. We research the competitive landscape, generate candidate names with a rationale, check availability at Companies House and common domain registrars, and deliver a shortlist with our reasoning rather than a long list that leaves you guessing.',
  },
  {
    q: 'Where are you based, and do you work in person?',
    a: 'Our studio is at Martland Mill in Burscough, rural West Lancashire, between Ormskirk and Southport and about 45 minutes from central Manchester or Liverpool. Most collaboration happens remotely, and we visit in person for brand discovery workshops, shoots and launches when they matter.',
  },
  {
    q: 'Can you handle the website, marketing and environmental consultancy too?',
    a: "Yes, and it's how we work best. Branding often leads into web design, development, marketing or environmental consultancy within the same project, and working together gives a far more coherent result than stitching three agencies together.",
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Sustainable Branding Agency: Brand Identity Design UK"
  description="OakFox is a sustainable branding agency in West Lancashire, UK. Brand identity, naming, voice and guidelines for independent businesses and established brands, built to last and free of greenwashing."
  schema={[serviceSchema, breadcrumbs, faqSchema]}
>
  <PageHero
    back={{ label: 'Services', href: '/services/' }}
    title="Brands built to last, not to trend."
    accent="last trend"
    intro="Brand identities for independent businesses and established brands that want to grow without the environmental cost. Naming, visual language, messaging and guidelines, designed to outlive the next rebrand."
  >
    <div slot="aside" class="rounded-2xl bg-forest text-cream p-8 md:p-10 overflow-hidden">
      <Specimen />
      <p class="mt-8 text-[15px] text-cream/75 leading-relaxed max-w-[34ch]">
        One typeface, every weight from 400 to 900, in a single 46 KB file.
        It's the one this site uses.
      </p>
    </div>
  </PageHero>

  <Pillars items={offerings} />

  <ProcessSteps title="How a branding project runs" steps={process} />

  <FitList title="A good fit if you're" items={forWho} />

  <FaqList title="Branding questions we hear a lot" items={faqs}>
    What a brand identity costs in practice:
    <a href="/blog/how-much-does-branding-cost-uk/" class="text-forest underline underline-offset-4">how much branding costs in the UK</a>.
  </FaqList>

  <LocationSignpost service="Branding" keyword="sustainable branding" />

  <JournalLinks
    intro="Longer reads on naming, briefing, and what sustainable branding involves."
    posts={journalPosts}
  />

  <AuditCta />

  <CtaBlock
    title="Ready for a brand that means something?"
    text="Send a few lines about your business and we'll reply within 24 hours to set up a free first call."
  />
</BaseLayout>
