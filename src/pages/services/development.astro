---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Pillars from '../../components/Pillars.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import FitList from '../../components/FitList.astro';
import FaqList from '../../components/FaqList.astro';
import LocationSignpost from '../../components/LocationSignpost.astro';
import AuditCta from '../../components/AuditCta.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import CarbonMeter from '../../components/CarbonMeter.astro';
import LiveMetrics from '../../components/demo/LiveMetrics.astro';

const pageUrl = 'https://oakfox.co.uk/services/development';

const serviceSchema = {
  '@type': 'Service',
  '@id': `${pageUrl}#service`,
  name: 'Development',
  description: 'Web development for brands that care what sits under the hood. Fast, accessible, sustainable builds with modern static-first architecture, hosted on verified green infrastructure.',
  provider: { '@id': 'https://oakfox.co.uk/#organization' },
  areaServed: ['United Kingdom', 'Ireland', 'Europe'],
  serviceType: 'Web development',
  url: pageUrl,
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://oakfox.co.uk/services' },
    { '@type': 'ListItem', position: 3, name: 'Development', item: pageUrl },
  ],
};

const offerings = [
  {
    title: 'Fast, accessible builds',
    description:
      'Static-first architecture where it fits, modern frameworks where they help. Optimised assets, minimal JavaScript and clean markup, so pages load before anyone notices.',
  },
  {
    title: 'CMS, APIs and integrations',
    description:
      'A headless CMS your team can edit without breaking the site. APIs for booking, forms and e-commerce, and integrations with the tools you already use, rather than a new platform to learn.',
  },
  {
    title: 'Green, fast infrastructure',
    description:
      "Deployed to verified renewable-powered hosting by default, with edge delivery, automatic deployments on every push, and monitoring that tells us something's broken before your customers do.",
  },
];

const process = [
  { title: 'Specify', body: 'A tight build spec: what the site has to do, the stack, integrations, hosting, CMS and deploy pipeline. Agreed before anyone writes code.' },
  { title: 'Scaffold', body: 'Repository, CI, staging and CMS go up first, so every page from then on deploys automatically and you can review it.' },
  { title: 'Build', body: 'Pages, components and templates built against the design system and tested on real devices, with performance and accessibility checked every sprint.' },
  { title: 'Launch', body: 'DNS cutover, redirects, analytics, sitemap and monitoring, in a controlled go-live.' },
  { title: 'Support', body: "An optional retainer for ongoing work, or a clean handover to your team, with documentation written for someone who wasn't in the room." },
];

const forWho = [
  'Brands with a design in hand and a developer deadline looming',
  'Businesses whose current site is slow, fragile or impossible for the team to update',
  'Sustainability-focused businesses who want their hosting to match their claims',
  'Founders burned by fashionable frameworks who want a site they can still run in five years',
  'Teams who want a site that passes a Lighthouse audit without compromises',
];

const faqs = [
  {
    q: 'What tech stack do you build websites on?',
    a: 'We default to static-first builds with Astro, Tailwind CSS for styling, MDX for content, and a headless CMS (Sanity, Contentful or Storyblok, depending on fit) when the client needs to edit. For applications we use React, Next.js or Vue where the complexity justifies it, but we start with the lightest architecture that solves the problem.',
  },
  {
    q: 'How much does a custom website build cost?',
    a: 'Custom web development at OakFox typically ranges from £2,500 for a static marketing site to £20,000 or more for a multi-section, CMS-driven site with integrations. Every quote is worked out case by case, and we send a detailed written proposal after a free first call.',
  },
  {
    q: 'What is "green web hosting" and why does it matter?',
    a: "Green web hosting runs on verified renewable power (solar, wind or hydro) rather than fossil-fuel-backed grid power. Websites account for a meaningful share of global digital emissions, so choosing a host is one of the highest-leverage sustainability decisions a business makes. We deploy by default to providers on The Green Web Foundation's verified list.",
  },
  {
    q: 'Do you work with Shopify, WordPress, or other CMS platforms?',
    a: "Yes, where they fit. Shopify for e-commerce when its feature set matches, and Shopify Hydrogen where a custom frontend is justified. WordPress only when the client has an existing setup we shouldn't break. For most marketing sites we prefer a headless CMS: faster, more secure, easier to maintain, and far fewer plugin conflicts.",
  },
  {
    q: 'Will my website be fast and pass Core Web Vitals?',
    a: 'Yes. Every site we build targets a Lighthouse performance score of 95 or more and green Core Web Vitals from launch. Static rendering, optimised images, minimal JavaScript and edge hosting give pages that load in well under a second on 4G. We check this every sprint, not just at the end.',
  },
  {
    q: 'Do you offer ongoing website support and maintenance?',
    a: "Yes. After launch we offer monthly retainers covering security updates, content edits, performance monitoring and small features, scoped to the hours you actually need rather than a fixed package. Or we hand over cleanly to your in-house team, with documentation written for someone who wasn't in the room.",
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Sustainable Web Development Agency, UK"
  description="OakFox builds fast, accessible, sustainable websites: static-first architecture with Astro, a headless CMS and verified green hosting, for brands that care what sits under the hood."
  schema={[serviceSchema, breadcrumbs, faqSchema]}
>
  <PageHero
    back={{ label: 'Services', href: '/services/' }}
    title="Websites that load. Pages that last."
    accent="load last"
    intro="Modern, static-first builds that send fewer bytes, load faster and use less energy. Deployed to verified renewable-powered hosting, and edited by your team through a CMS they'll actually use."
  >
    <div slot="aside" class="space-y-4">
      <CarbonMeter heading="This page, built by us, as it loaded" showForm={false} />
      <div class="rounded-2xl bg-ink text-cream p-6 md:p-7">
        <LiveMetrics />
      </div>
    </div>
  </PageHero>

  <Pillars items={offerings} />

  <ProcessSteps title="How a build runs, from spec to support" steps={process} />

  <FitList title="A good fit if you're" items={forWho} />

  <FaqList title="Web development questions we hear a lot" items={faqs}>
    Typical prices, from DIY builders to agencies:
    <a href="/blog/how-much-does-a-website-cost-uk/" class="text-forest underline underline-offset-4">how much a website costs in the UK</a>.
  </FaqList>

  <LocationSignpost service="Web development" keyword="sustainable web development" />

  <AuditCta />

  <CtaBlock
    title="Got designs. Need a build."
    text="Send what you have: designs, an existing URL, a line about the scope. We reply within 24 hours with a first read on complexity and timeline."
  />
</BaseLayout>
