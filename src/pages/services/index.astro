---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServicesBento from '../../components/ServicesBento.astro';
import LocationSignpost from '../../components/LocationSignpost.astro';
import AuditCta from '../../components/AuditCta.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import GreenCheck from '../../components/demo/GreenCheck.astro';

const pageUrl = 'https://oakfox.co.uk/services';

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: pageUrl },
  ],
};

const practices = [
  {
    title: 'Sustainable brand identity',
    description:
      'Identity systems, voice and guidelines for businesses that want to grow without the environmental cost. Built to last rather than to follow trends.',
    href: '/services/branding/',
    cta: 'See branding',
    tone: 'forest',
  },
  {
    title: 'Sustainability, proven not claimed',
    description:
      'Verified green hosting and original ecological research in every project, plus EcoScribe, our venture automating ecology reports (PEA, BNG, SFI) for the environmental sector.',
    href: '/services/environmental/',
    cta: 'See environmental',
    tone: 'ink',
  },
];
---

<BaseLayout
  title="Sustainable Design & Web Services, UK Studio"
  description="Branding, web design, development, copywriting, marketing and green hosting from an independent West Lancashire studio. Six services, one person accountable for each."
  schema={[breadcrumbs]}
>
  <PageHero
    title="Two practices, one standard."
    accent="standard"
    intro="Branding and environmental are our two dedicated practices, alongside web design, development, copywriting and marketing. Every project is held to the same belief: work that respects the planet performs better and lasts longer."
  />

  <section class="pb-16 md:pb-24">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <h2 class="headline text-4xl md:text-5xl max-w-[18ch]">Six services, each one shown working.</h2>
      <div class="mt-10 md:mt-14"><ServicesBento /></div>
    </div>
  </section>

  <!-- Green hosting has no tile in the bento, so it gets its own band. -->
  <section class="py-16 md:py-24 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-7">
        <h2 class="headline text-4xl md:text-5xl">And the hosting underneath it.</h2>
        <p class="mt-6 text-lg text-ink/70 leading-relaxed max-w-[48ch]">
          Managed green hosting in UK data centres, with setup, DNS, SSL, backups and
          monitoring handled for you. Free migration on every plan, from £9.99 a month.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="/services/green-web-hosting/" class="btn-primary">See the hosting plans</a>
          <a href="/website-carbon-audit/" class="link-line text-[15px] font-medium text-ink hover:text-forest transition-colors">Check your current host</a>
        </div>
      </div>
      <GreenCheck class="lg:col-span-5" />
    </div>
  </section>

  <!-- The two dedicated practices. -->
  <section class="py-16 md:py-24 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <h2 class="headline text-4xl md:text-5xl">The two practices at the centre</h2>
      <div class="mt-10 md:mt-14 grid md:grid-cols-2 gap-4 md:gap-5">
        {practices.map((p) => (
          <a
            href={p.href}
            class={`reveal group flex flex-col justify-between min-h-[20rem] rounded-2xl p-8 md:p-10 transition-transform duration-300 hover:-translate-y-0.5 ${p.tone === 'forest' ? 'bg-forest text-cream' : 'bg-ink text-cream'}`}
          >
            <h3 class="text-3xl md:text-4xl font-semibold tracking-tight leading-[1.1] max-w-[16ch]">{p.title}</h3>
            <div class="mt-10">
              <p class="text-lg text-cream/75 leading-relaxed max-w-[48ch]">{p.description}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-[15px] font-medium text-leaf">
                {p.cta}
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <LocationSignpost service="Design" keyword="design and consultancy" />

  <AuditCta />

  <CtaBlock
    title="Not sure which fits?"
    text="Send a few lines about what you're trying to do. We reply within 24 hours and point you to the right starting point, or tell you if we're not the right fit."
  />
</BaseLayout>
