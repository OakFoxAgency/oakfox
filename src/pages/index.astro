---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../lib/posts';
import CarbonMeter from '../components/CarbonMeter.astro';
import CarbonWaffle from '../components/CarbonWaffle.astro';
import ServicesBento from '../components/ServicesBento.astro';
import CtaBlock from '../components/CtaBlock.astro';
import study from '../../public/data/oakfox-uk-sme-carbon-study-2026-07-aggregates.json';

const workItems = (await getCollection('portfolio'))
  .sort(
    (a, b) =>
      (a.data.order ?? Infinity) - (b.data.order ?? Infinity) ||
      b.data.date.valueOf() - a.data.date.valueOf()
  )
  .slice(0, 5);

const blogPosts = (await getCollection('blog', isPublished))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const categoryNames: Record<string, string> = {
  development: 'Design and development',
  design: 'Brand and web design',
  consultancy: 'Research',
};

const ratings = study.ratings as Record<string, number>;
const aOrBetter = (ratings['A+'] ?? 0) + (ratings.A ?? 0);
const medianMB = (study.weight.medKB / 1000).toFixed(1);

const testimonials = [
  {
    quote:
      'They completely blew past our expectations. The design is beautifully polished, the development is seamless, and their communication throughout the project was first-class.',
    name: 'Wesley Boyce',
    org: 'brand identity and website',
  },
  {
    quote:
      'I absolutely love the look and feel of my new author website. They are so easy to work with and accommodating. I can recommend OakFox 100%.',
    name: 'Jennifer Lane',
    org: 'Jennifer Lane Writes',
  },
];

const homeSchema = {
  '@type': 'WebPage',
  '@id': 'https://oakfox.co.uk/#webpage',
  url: 'https://oakfox.co.uk/',
  name: 'OakFox, sustainable web design and branding in Ormskirk, West Lancashire',
  description:
    'OakFox is a sustainable design studio based in Ormskirk, West Lancashire, UK, offering branding, web design, development, marketing, and environmental consultancy for independent businesses and established brands.',
  inLanguage: 'en-GB',
  isPartOf: { '@id': 'https://oakfox.co.uk/#website' },
  about: { '@id': 'https://oakfox.co.uk/#organization' },
  primaryImageOfPage: 'https://oakfox.co.uk/og-default.png',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    ],
  },
};

const splitWords = (text: string) => text.split(' ');
const quoteWords = splitWords(`“${testimonials[0].quote}”`);
---

<BaseLayout
  title="Sustainable Web Design & Branding in Ormskirk"
  description="OakFox is a sustainable web design and branding studio in Ormskirk, West Lancashire. Websites, brands, copy and marketing for independent businesses, with the carbon of every site measured."
  schema={homeSchema}
>
  <!-- ========== HERO ==========
       The keyword-led headline, and beside it a live breakdown of what this
       page weighed as it loaded: the claim and the evidence in one view. -->
  <section data-scene="hero" class="relative lg:min-h-[min(100dvh,58rem)] lg:flex lg:items-center">
    <div class="w-full max-w-[1400px] mx-auto px-6 md:px-10 pt-28 md:pt-36 lg:pt-28 pb-16 md:pb-24 lg:pb-12 grid lg:grid-cols-12 gap-y-12 lg:gap-x-12 xl:gap-x-16 items-center">
      <div class="lg:col-span-7">
        <h1 class="headline hero-title text-ink">
          <span class="block whitespace-nowrap">
            {splitWords('Sustainable web design').map((w, i, a) => (
              <><span class="split-word"><span>{w}</span></span>{i < a.length - 1 && ' '}</>
            ))}
          </span>
          <span class="block">
            {splitWords('& branding').map((w, i, a) => (
              <><span class="split-word"><span>{w}</span></span>{i < a.length - 1 && ' '}</>
            ))}
          </span>
          <span class="hero-place"><span class="split-word"><span>in Ormskirk, West Lancashire</span></span></span>
        </h1>
        <p data-hero-paragraph class="mt-8 text-lg md:text-xl text-ink/70 leading-relaxed max-w-[42ch]">
          We design and build brands and websites for independent businesses,
          and measure the carbon of every one.
        </p>
        <div data-hero-cta class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="/contact/" class="btn-primary">Start a project</a>
          <a href="/book/" class="link-line text-[15px] font-medium text-ink hover:text-forest transition-colors">Book a call</a>
        </div>
      </div>

      <!-- Live meter: this page's own first view, by type of file. -->
      <div data-hero-aside class="lg:col-span-5 max-w-xl lg:max-w-none">
        <CarbonMeter />
      </div>
    </div>
  </section>

  <!-- ========== WORK ==========
       Pinned on desktop and panned sideways as you scroll; a swipeable row on
       phones (motion.ts adds hwork--static there). -->
  <section data-scene="hwork" class="hwork relative overflow-hidden border-t border-stone">
    <div data-h-track class="hwork-track">
      <div class="hwork-intro">
        <h2 class="headline text-5xl md:text-7xl">Selected work</h2>
        <p class="mt-6 text-lg text-ink/70 leading-relaxed max-w-[30ch]">
          Apps, a game, websites and original research, for clients and for ourselves.
        </p>
        <a href="/portfolio/" class="mt-8 inline-block link-line text-[15px] font-medium text-ink hover:text-forest transition-colors">All work</a>
      </div>
      {workItems.map((item) => (
        <a href={`/portfolio/${item.id}/`} class="hwork-card group" data-h-card>
          <div class="img-wrap rounded-2xl bg-moss aspect-[16/10]">
            <Img src={item.data.thumbnail} alt={item.data.title} class="w-full h-full object-cover object-top" />
          </div>
          <div class="mt-5 flex items-baseline justify-between gap-6">
            <h3 class="text-2xl md:text-3xl font-semibold tracking-tight group-hover:text-forest transition-colors">{item.data.title}</h3>
            <span class="label text-ink/65 shrink-0">{categoryNames[item.data.category] ?? item.data.category}</span>
          </div>
          <p class="mt-2 text-base text-ink/70 leading-relaxed line-clamp-2 max-w-[60ch]">{item.data.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ========== WHAT WE DO ==========
       Six tiles, each showing the craft rather than describing it. -->
  <section class="py-20 md:py-32 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10">
      <h2 class="headline text-4xl md:text-6xl max-w-[16ch]">What we do, shown rather than told.</h2>

      <div class="mt-12 md:mt-16"><ServicesBento /></div>
    </div>
  </section>

  <!-- ========== THE STUDY ==========
       One dot per homepage we audited, coloured by grade; ours is ringed. -->
  <section class="py-20 md:py-32 border-t border-stone">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-5">
        <h2 class="headline text-4xl md:text-5xl">We audited 100 UK small business websites. {aOrBetter} earned an A.</h2>
        <p class="mt-6 text-lg text-ink/70 leading-relaxed max-w-[42ch]">
          The median homepage weighed {medianMB} MB, and images made up {Math.round(study.assetShares.images)}% of every
          byte. Each dot is one site. The ringed one is ours.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="/website-carbon-audit/" class="btn-primary">Check your website</a>
          <a href="/blog/we-audited-100-uk-small-business-websites/" class="link-line text-[15px] font-medium text-ink hover:text-forest transition-colors">Read the study</a>
        </div>
      </div>
      <CarbonWaffle class="lg:col-span-7" />
    </div>
  </section>

  <!-- ========== TESTIMONIALS ==========
       The lead quote lights up word by word as it scrolls through. -->
  <section data-scene="quote" class="py-20 md:py-32 border-t border-stone">
    <h2 class="sr-only">What clients say</h2>
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 grid lg:grid-cols-12 gap-12 lg:gap-16">
      <figure class="lg:col-span-9">
        <blockquote class="text-3xl md:text-5xl font-semibold tracking-tight leading-[1.15] text-ink">
          {quoteWords.map((w, i) => (<><span data-word>{w}</span>{i < quoteWords.length - 1 && ' '}</>))}
        </blockquote>
        <figcaption class="mt-8 text-[15px]">
          <span class="font-semibold text-ink">{testimonials[0].name}</span><span class="text-ink/65">, {testimonials[0].org}</span>
        </figcaption>
      </figure>
      <figure class="lg:col-span-3 lg:self-end">
        <blockquote class="text-lg text-ink/80 leading-relaxed">“{testimonials[1].quote}”</blockquote>
        <figcaption class="mt-4 text-[15px]">
          <span class="font-semibold text-ink">{testimonials[1].name}</span><span class="text-ink/65">, {testimonials[1].org}</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ========== JOURNAL ========== -->
  {blogPosts.length > 0 && (
    <section class="py-16 md:py-24 border-t border-stone">
      <div class="max-w-[1400px] mx-auto px-6 md:px-10">
        <div class="flex items-end justify-between gap-6 mb-6 md:mb-8">
          <h2 class="headline text-4xl md:text-5xl">Journal</h2>
          <a href="/blog/" class="link-line text-[15px] font-medium text-ink hover:text-forest transition-colors">All posts</a>
        </div>
        <ul class="border-t border-stone">
          {blogPosts.map((post) => (
            <li class="border-b border-stone">
              <a href={`/blog/${post.id}/`} class="post-row group grid md:grid-cols-12 gap-2 md:gap-8 py-6 md:py-8 items-baseline">
                <time class="md:col-span-2 text-[15px] text-ink/65 figures" datetime={post.data.date.toISOString().slice(0, 10)}>
                  {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
                </time>
                <span class="md:col-span-6 text-xl md:text-2xl font-semibold tracking-tight text-ink group-hover:text-forest transition-colors">
                  {post.data.title}
                </span>
                <span class="md:col-span-4 flex items-baseline justify-between gap-6 text-[15px] text-ink/65 leading-relaxed">
                  <span class="line-clamp-2">{post.data.description}</span>
                  <svg class="post-arrow w-5 h-5 shrink-0 text-forest" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <CtaBlock />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  /* Two lines at any desktop width: "Sustainable web design" measures about
     10.4em, so the size tracks the 7-column width and caps where that column
     stops growing (the 1400px container). */
  .hero-title {
    font-size: clamp(2.6rem, 4.6vw, 4.375rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .hero-place {
    display: block;
    margin-top: 1.1rem;
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: color-mix(in oklab, var(--color-ink) 66%, transparent);
  }
  @media (max-width: 1023px) {
    .hero-title .whitespace-nowrap { white-space: normal; }
  }

  /* ---------- Work (horizontal) ---------- */
  .hwork-track {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    width: max-content;
    min-height: 100dvh;
    padding: 6rem max(1.5rem, calc((100vw - 1400px) / 2 + 2.5rem));
  }
  .hwork-intro { width: min(30vw, 26rem); flex-shrink: 0; }
  .hwork-card {
    display: block;
    width: min(58vw, 54rem);
    flex-shrink: 0;
    transform: scale(var(--s, 1));
    opacity: var(--o, 1);
    transform-origin: center;
  }
  /* Phones and tablets: a swipeable row. */
  :global(.hwork--static) .hwork-track {
    width: auto;
    min-height: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1.5rem;
    padding: 4rem 1.5rem;
    align-items: start;
  }
  :global(.hwork--static) .hwork-intro { width: 78vw; scroll-snap-align: start; }
  :global(.hwork--static) .hwork-card { width: 84vw; scroll-snap-align: start; transform: none; opacity: 1; }
  @media (min-width: 768px) {
    :global(.hwork--static) .hwork-intro { width: 40vw; }
    :global(.hwork--static) .hwork-card { width: 64vw; }
  }
  /* Large screens with reduced motion: no pin, a plain two-column grid. */
  @media (min-width: 1024px) {
    :global(.hwork--static) .hwork-track {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4rem 3rem;
      max-width: 1400px;
      margin-inline: auto;
      padding: 6rem 2.5rem;
      overflow: visible;
    }
    :global(.hwork--static) .hwork-intro,
    :global(.hwork--static) .hwork-card { width: auto; }
  }

  /* ---------- Journal ---------- */
  .post-arrow { opacity: 0; transform: translateX(-6px); transition: opacity 0.3s, transform 0.3s; }
  .post-row:hover .post-arrow { opacity: 1; transform: none; }

</style>
