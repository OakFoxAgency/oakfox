---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBlock from '../components/CtaBlock.astro';

const link = 'class="text-forest underline underline-offset-4"';

// Answers carry links, so they render as HTML; the schema gets them stripped.
const faqs = [
  {
    q: 'What does OakFox do?',
    a: `OakFox is a sustainable design studio based in West Lancashire. We offer <a href="/services/branding/" ${link}>branding</a>, <a href="/services/web-design/" ${link}>web design</a>, <a href="/services/development/" ${link}>web development</a>, <a href="/services/copywriting/" ${link}>copywriting</a>, <a href="/services/marketing/" ${link}>marketing</a> and <a href="/services/green-web-hosting/" ${link}>green web hosting</a>, often in combination, for businesses that want to grow without the environmental cost. Dedicated ecology reporting and automation (PEA, BNG, SFI) is handled by our venture, <a href="https://ecoscribe.co.uk" ${link}>EcoScribe</a>.`,
  },
  {
    q: 'Where is OakFox based? Do you work with clients outside the UK?',
    a: `We're based in rural West Lancashire and registered as a company in England. Our studio is in <a href="/locations/burscough/" ${link}>Burscough</a>, between <a href="/locations/ormskirk/" ${link}>Ormskirk</a> and <a href="/locations/southport/" ${link}>Southport</a>. We work with clients across the UK, Ireland and mainland Europe; see our <a href="/locations/" ${link}>locations page</a> for where we know the ground best. Most collaboration happens remotely, with occasional visits for brand discovery, shoots or installations.`,
  },
  {
    q: 'What does a typical OakFox project look like?',
    a: 'Most projects start with a discovery conversation, followed by a proposal, a defined scope and delivery in phases, usually over six to fourteen weeks depending on complexity. We take on a small number of projects each quarter so every client gets proper attention.',
  },
  {
    q: 'How much does it cost to work with OakFox?',
    a: `Every project is priced case by case. We work with a range of businesses, from independent start-ups to established brands, and shape each quote around what your project actually needs rather than slotting you into a tier. We'll talk through the specifics on a free first call and send a detailed written quote before you commit to anything. For typical UK ranges and what drives them, see <a href="/blog/how-much-does-a-website-cost-uk/" ${link}>how much a website costs in the UK</a>.`,
  },
  {
    q: 'How long does a project take?',
    a: 'Most projects take six to fourteen weeks. A focused brand refresh can be quicker; a full brand and website build with several stakeholders takes longer. We set a realistic timeline while scoping and protect it with milestone reviews.',
  },
  {
    q: 'What makes OakFox "sustainable"? Is it just greenwashing?',
    a: "Sustainability runs through every decision we make: the client work we take on, the hosting and code we deliver, and the supply chain advice we give. We consult on sourcing, packaging and waste for client operations, specify efficient hosting and lightweight builds on web projects, and we're honest about the limits. A website alone isn't going to save the planet, but every considered choice adds up.",
  },
  {
    q: 'Do you only work with sustainable or ethical brands?',
    a: "No, but we reserve the right to decline projects we can't get behind. We'd rather help a business we believe in improve its impact than polish the image of one that won't change its practices.",
  },
  {
    q: 'Who will I actually work with day to day?',
    a: "Nathan James Entwistle, OakFox's founder, leads every project directly. We bring in trusted collaborators (photographers, illustrators, specialist developers) when the work calls for it, but your main point of contact stays the same throughout.",
  },
  {
    q: 'Do you do ongoing work like marketing retainers?',
    a: 'Yes. After the first delivery, many clients carry on with us on monthly retainers for marketing, website upkeep, sustainability reporting or creative support. Retainers are scoped to the hours and services you actually need, so they fit the rhythm of your business rather than a fixed package.',
  },
  {
    q: 'How do I start a project with you?',
    a: 'Send a note through our contact page with a few lines about your business and what you are hoping to do. We reply within 24 hours to set up a free first call, with no pitch and no obligation.',
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]*>/g, '');

const faqSchema = {
  '@type': 'FAQPage',
  '@id': 'https://oakfox.co.uk/faq#faq',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(item.a),
    },
  })),
};

const breadcrumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://oakfox.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: 'https://oakfox.co.uk/faq' },
  ],
};
---

<BaseLayout
  title="FAQ: OakFox Sustainable Design Studio"
  description="Common questions about working with OakFox: pricing, timelines, sustainability credentials, retainers, and how to start a project with our West Lancashire studio."
  schema={[faqSchema, breadcrumbs]}
>
  <PageHero
    title="Questions we hear most often."
    accent="often"
    intro="Pricing, timelines, who you'll work with and what sustainable actually means here. If your question isn't covered, send us a note: we reply within 24 hours."
  />

  <section class="pb-16 md:pb-24">
    <div class="max-w-[1400px] mx-auto px-6 md:px-10 grid lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-8 lg:order-2 border-t border-stone">
        {faqs.map((f, i) => (
          <details class="faq border-b border-stone" open={i === 0}>
            <summary class="flex items-start justify-between gap-6 py-6 md:py-7 cursor-pointer list-none">
              <h2 class="text-xl md:text-2xl font-semibold tracking-tight text-ink">{f.q}</h2>
              <span class="plus shrink-0 mt-2 w-5 h-5 relative" aria-hidden="true"></span>
            </summary>
            <div class="pb-8 -mt-1 text-base md:text-lg text-ink/75 leading-relaxed max-w-[68ch]" set:html={f.a} />
          </details>
        ))}
      </div>
      <aside class="lg:col-span-4 lg:order-1 lg:sticky lg:top-28 rounded-2xl bg-ink text-cream p-7 md:p-9">
        <p class="text-2xl font-semibold tracking-tight">Not covered here?</p>
        <p class="mt-3 text-base text-cream/70 leading-relaxed">Ask us directly. We reply within 24 hours.</p>
        <div class="mt-7 flex flex-col gap-3">
          <a href="/contact/" class="btn-light">Send a message</a>
          <a href="/book/" class="text-center text-[15px] font-medium text-cream underline underline-offset-4 py-2">Book a call</a>
        </div>
        <dl class="mt-7 pt-6 border-t border-cream/10 space-y-4 text-[15px]">
          <div>
            <dt class="text-[13px] text-cream/55">Phone</dt>
            <dd><a href="tel:+441704773233" class="hover:text-leaf transition-colors">01704 773233</a></dd>
          </div>
          <div>
            <dt class="text-[13px] text-cream/55">Email</dt>
            <dd><a href="mailto:nathan@oakfox.co.uk" class="hover:text-leaf transition-colors">nathan@oakfox.co.uk</a></dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <CtaBlock title="Still curious? Let's talk it through." showLocations={false} />
</BaseLayout>

<style>
  summary::-webkit-details-marker { display: none; }
  summary:hover h2 { color: var(--color-forest); }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: var(--color-forest);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .plus::after { transform: rotate(90deg); }
  .faq[open] .plus::after { transform: rotate(0deg); }
</style>
